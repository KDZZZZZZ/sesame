            "minLength": 1
          },
          "rowCount": {
            "type": "integer",
            "minimum": 0
          },
          "columns": {
            "type": "array"
          },
          "provenance": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "format",
          "path",
          "rowCount",
          "columns",
          "provenance"
        ],
        "additionalProperties": true
      }
    }
  ]
}
