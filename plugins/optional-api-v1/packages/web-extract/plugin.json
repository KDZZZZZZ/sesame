{
  "id": "sesame/web-extract",
  "apiVersion": "2",
  "version": "3.0.2",
  "title": "网页正文提取",
  "description": "信息解析能力：从已有完整HTML提取标题、文本、绝对链接和元数据；接收冻结source_ref、inline内容或包内文件，不联网、不解释市场。source_ref输入自动保留来源引用。",
  "license": "MIT",
  "author": {
    "name": "Sesame"
  },
  "default_state": "discoverable",
  "agent_scope": "all",
  "execution": "native",
  "capability_manifest": "capabilities.json",
  "prompts": [],
  "skills": [
    "skills"
  ],
  "resources": [],
  "engines": {
    "sesame": ">=0.3.0-dev.1 <0.4.0"
  },
  "entry": "index.js",
  "permissions": {
    "scopes": [
      "process.execute"
    ],
    "calls": [
      "host.process.exec"
    ]
  }
}
