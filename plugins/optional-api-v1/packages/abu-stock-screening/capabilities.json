{
  "schemaVersion": 1,
  "apiVersion": "2",
  "capabilities": [
    {
      "id": "abu_stock_screening_analyze",
      "kind": "function",
      "consumers": [
        "agent",
        "host"
      ],
      "description": "在给定股票池内按动量、趋势、价格位置与路径效率生成透明的横截面排名。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "input": {
            "type": "object",
            "properties": {
              "schema_version": {
                "const": 1
              },
              "source": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  "kind": {
                    "enum": [
                      "synthetic",
                      "historical",
                      "live"
                    ]
                  }
                },
                "required": [
                  "id",
                  "kind"
                ],
                "additionalProperties": true,
                "description": "Caller-declared provenance; synthetic remains synthetic in output artifacts."
              },
              "as_of": {
                "type": "string",
                "description": "Canonical UTC YYYY-MM-DDTHH:mm:ss.sssZ, including milliseconds; preserve actual evidence time."
              },
              "parameters": {
                "type": "object",
                "properties": {
                  "momentum_window": {
                    "type": "integer",
                    "default": 5,
                    "minimum": 1,
                    "maximum": 500,
                    "description": "动量回看根数"
                  },
                  "trend_window": {
                    "type": "integer",
                    "default": 8,
                    "minimum": 3,
                    "maximum": 500,
                    "description": "趋势窗口"
                  },
                  "efficiency_window": {
                    "type": "integer",
                    "minimum": 3,
                    "maximum": 500,
                    "description": "路径效率窗口，默认 trend_window 或 8"
                  },
                  "price_window": {
                    "type": "integer",
                    "default": 20,
                    "minimum": 2,
                    "maximum": 1000,
                    "description": "价格位置窗口"
                  },
                  "top_n": {
                    "type": "integer",
                    "default": 10,
                    "minimum": 1,
                    "maximum": 100,
                    "description": "最多返回排名数"
                  },
                  "max_instruments": {
                    "type": "integer",
                    "default": 50,
                    "minimum": 2,
                    "maximum": 500,
                    "description": "股票池数量上限"
                  },
                  "max_bars_per_instrument": {
                    "type": "integer",
                    "default": 5000,
                    "minimum": 10,
                    "maximum": 10000,
                    "description": "每标的根数上限"
                  }
                },
                "additionalProperties": false,
                "description": "Optional overrides. Defaults and limits match the existing calculation."
              },
              "instruments": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "bars": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "time": {
                            "type": "string",
                            "description": "Canonical UTC YYYY-MM-DDTHH:mm:ss.sssZ, including milliseconds; preserve actual evidence time."
                          },
                          "available_at": {
                            "type": "string",
                            "description": "Canonical UTC YYYY-MM-DDTHH:mm:ss.sssZ, including milliseconds; preserve actual evidence time."
                          },
                          "open": {
                            "type": "number"
                          },
                          "high": {
                            "type": "number"
                          },
                          "low": {
                            "type": "number"
                          },
                          "close": {
                            "type": "number"
                          },
                          "volume": {
                            "type": "number"
                          }
                        },
                        "additionalProperties": true,
                        "required": [
                          "time",
                          "available_at",
                          "open",
                          "high",
                          "low",
                          "close",
                          "volume"
                        ]
                      },
                      "maxItems": 10000,
                      "minItems": 1,
                      "description": "bars 是 1..10000 条已知 OHLCV，按收盘 time 严格递增且不重复；每行含 time、available_at、open/high/low/close、volume。time <= available_at <= as_of，价格为正且 high/low 覆盖 open/close，volume >= 0。"
                    }
                  },
                  "additionalProperties": true,
                  "required": [
                    "id",
                    "bars"
                  ]
                },
                "maxItems": 10000,
                "minItems": 1,
                "description": "instruments 为 1..max_instruments 个 {id,bars}；id 唯一、1..80 字符且只含字母数字 _ . : -。各标的最新 bar.time 必须一致；bars 遵循 OHLCV 契约且不超过 max_bars_per_instrument。efficiency_window 省略时使用 trend_window，再省略则为 8。"
              }
            },
            "additionalProperties": true,
            "required": [
              "schema_version",
              "source",
              "as_of",
              "instruments"
            ],
            "description": "完整的固定输入对象；examples/input.json 仅为合成格式示例，不是实盘证据。"
          }
        },
        "required": [
          "input"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "schema_version": {
            "const": 1
          },
          "baseline": {
            "const": true
          },
          "status": {
            "const": "research_baseline"
          },
          "parameters": {
            "type": "object"
          },
          "observations": {
            "description": "observations.universe_size 为输入池大小，all 为全部标的指标/排除原因，top 为合格标的前 top_n；baseline_note 解释评分。"
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "input_artifact": {
            "type": "object",
            "description": "立即返回 {schema_version:1,baseline:true,status:\"research_baseline\",source,as_of,parameters,observations,limitations,input_sha256,implementation_sha256,input_artifact,result_artifact}。两个 artifact 是完整不可变 DataRef，保留 id/revision/digest/kind/schemaVersion；若需再次读取，可将完整 ref 传给 data_read({ref})（需 data-access/workspace）。input_artifact 保存 [{input}]，result_artifact 保存 [{...计算结果}]，后者不自包含 artifact 引用。"
          },
          "result_artifact": {
            "type": "object",
            "description": "立即返回 {schema_version:1,baseline:true,status:\"research_baseline\",source,as_of,parameters,observations,limitations,input_sha256,implementation_sha256,input_artifact,result_artifact}。两个 artifact 是完整不可变 DataRef，保留 id/revision/digest/kind/schemaVersion；若需再次读取，可将完整 ref 传给 data_read({ref})（需 data-access/workspace）。input_artifact 保存 [{input}]，result_artifact 保存 [{...计算结果}]，后者不自包含 artifact 引用。"
          }
        },
        "required": [
          "schema_version",
          "baseline",
          "status",
          "parameters",
          "observations",
          "limitations",
          "input_artifact",
          "result_artifact"
        ],
        "additionalProperties": true
      },
      "execution": "immediate",
      "effects": [
        "resources.create",
        "resources.publish"
      ],
      "binding": {
        "type": "native",
        "name": "abu_stock_screening_analyze"
      },
      "usage": {
        "purpose": "在给定股票池内按动量、趋势、价格位置与路径效率生成透明的横截面排名。",
        "inputs": "调用形状为 {input:{schema_version:1,source:{id,kind},as_of,parameters?,...}}，不是文件路径或数据 ID。source.id 为 1..500 字符，kind 为 synthetic/historical/live；as_of 及全部时间字段使用真实 UTC YYYY-MM-DDTHH:mm:ss.sssZ（含毫秒）。输入限 2MiB 有限 JSON，不接收代码。parameters 只支持列出的字段。 bars 是 1..10000 条已知 OHLCV，按收盘 time 严格递增且不重复；每行含 time、available_at、open/high/low/close、volume。time <= available_at <= as_of，价格为正且 high/low 覆盖 open/close，volume >= 0。 instruments 为 1..max_instruments 个 {id,bars}；id 唯一、1..80 字符且只含字母数字 _ . : -。各标的最新 bar.time 必须一致；bars 遵循 OHLCV 契约且不超过 max_bars_per_instrument。efficiency_window 省略时使用 trend_window，再省略则为 8。",
        "outputs": "observations.universe_size 为输入池大小，all 为全部标的指标/排除原因，top 为合格标的前 top_n；baseline_note 解释评分。 立即返回 {schema_version:1,baseline:true,status:\"research_baseline\",source,as_of,parameters,observations,limitations,input_sha256,implementation_sha256,input_artifact,result_artifact}。两个 artifact 是完整不可变 DataRef，保留 id/revision/digest/kind/schemaVersion；若需再次读取，可将完整 ref 传给 data_read({ref})（需 data-access/workspace）。input_artifact 保存 [{input}]，result_artifact 保存 [{...计算结果}]，后者不自包含 artifact 引用。",
        "prerequisites": [
          "提供与任务相符的已知输入；本能力不联网取数，不需要 Python、ABU 安装或券商账户。"
        ],
        "limitations": [
          "只覆盖传入股票池，不能称为全市场筛选。历史不足的标的不参与排名；等权指标排名不证明流动性、可交易性或收益。",
          "来源与 available_at 是调用方声明，能力不会独立验证供应商历史；synthetic 证据必须保持演示标记。结果是研究观察，不是订单、成交或收益证明。"
        ]
      }
    }
  ],
  "sources": [],
  "views": [],
  "services": [],
  "knowledge": [
    {
      "id": "knowledge-0",
      "path": "examples/input.json",
      "description": "股票筛选基线 — examples/input.json",
      "kind": "reference"
    },
    {
      "id": "knowledge-1",
      "path": "prompt.md",
      "description": "股票筛选基线 — prompt.md",
      "kind": "prompt"
    },
    {
      "id": "knowledge-2",
      "path": "PROVENANCE.md",
      "description": "股票筛选基线 — PROVENANCE.md",
      "kind": "reference"
    },
    {
      "id": "knowledge-3",
      "path": "README.md",
      "description": "股票筛选基线 — README.md",
      "kind": "reference"
    },
    {
      "id": "knowledge-4",
      "path": "skills/abu-stock-screening/references/method.md",
      "description": "股票筛选基线 — skills/abu-stock-screening/references/method.md",
      "kind": "reference"
    },
    {
      "id": "knowledge-5",
      "path": "skills/abu-stock-screening/SKILL.md",
      "description": "股票筛选基线 — skills/abu-stock-screening/SKILL.md",
      "kind": "skill"
    }
  ],
  "hooks": [],
  "stateCollections": [],
  "artifactSchemas": [
    {
      "id": "data",
      "kind": "data",
      "schemaVersion": "1.0.0",
      "schema": {
        "type": "object",
        "properties": {
          "format": {
            "const": "json-rows"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "rowCount": {
            "type": "integer",
            "minimum": 0
          },
          "columns": {
            "type": "array"
          },
          "provenance": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "format",
          "path",
          "rowCount",
          "columns",
          "provenance"
        ],
        "additionalProperties": true
      }
    }
  ],
  "configSchema": {
    "type": "object",
    "properties": {},
    "additionalProperties": false
  }
}
