                "revision",
                "digest",
                "kind",
                "schemaVersion"
              ],
              "additionalProperties": false
            },
            "description": "Existing fixed evidence to reuse. Account snapshots are optional evidence, never an execution binding."
          },
          "start_from": {
            "type": "object",
            "description": "Rerun a completed research suffix. Inherits title/question/subjects/as_of/horizon/input evidence from result_ref, so do not repeat them. Retains only members and QA before role; uses the supplied research/model for new work. Original result and report remain unchanged.",
            "properties": {
              "result_ref": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "revision": {
                    "type": "string",
                    "minLength": 1
                  },
                  "digest": {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}$"
                  },
                  "kind": {
                    "const": "data"
                  },
                  "schemaVersion": {
                    "const": "1.0.0"
                  }
                },
                "required": [
                  "id",
                  "revision",
                  "digest",
                  "kind",
                  "schemaVersion"
                ],
                "additionalProperties": false,
                "description": "Exact complete result_ref produced by investment_research_analyze (one sesame.investment-research.result data row)."
              },
              "role": {
                "enum": [
                  "bull",
                  "bear",
                  "risk",
                  "manager"
                ],
                "description": "First role to rerun. For after bull/bear use risk."
              }
            },
            "required": [
              "result_ref",
              "role"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "research",
          "model"
        ],
        "additionalProperties": false,
        "anyOf": [
          {
            "required": [
              "title",
              "question",
              "subjects"
            ]
          },
          {
            "required": [
              "start_from"
            ]
          }
        ]
      },
      "effects": [
        "start:agents",
        "resources.create",
        "resources.publish",
        "invoke:selected-research",
        "publish:report-if-requested"
      ],
      "usage": {
        "purpose": "Combine source facts and complementary methods to answer a research question without entering a trading plan.",
        "inputs": "Use title, question, subjects, research:{plugins,tools?}, model:{provider,id}, optional as_of/horizon/evidence_refs/agent_models. Models come from the host model catalog. Invoke with a stable host operationId; optional task.output:{type:'report',space:'research',path:'...html'} binds the manager report. Omit output or use none for research data and Markdown only. The capability declares its collaboration; do not copy it into separate Agent roots. To rerun from an existing completed result, pass {start_from:{result_ref,role},research,model,agent_models?}; role is bull, bear, risk or manager. Original research metadata and earlier member/QA results are inherited, so omit title/question/subjects/as_of/horizon/evidence_refs. New report output uses a new path.",
        "outputs": "Accepted native workflow Run. Its final output is {result_ref,summary,report_ref?}. result_ref is one fixed json-rows data artifact containing schemaVersion/type/status/title/question/subjects/as_of/horizon?, complete members[{role,markdown,run_ref,source_refs}], qa[{from,to,question,markdown,run_ref,qa_run_ref,source_refs}], manager summary, source_refs and optional report_ref. Use host Run read/wait/interrupt/resume/cancel; no second business-run API. Suffix reruns include start_from and retained member RunRefs; evidence_refs records the original input evidence separately.",
        "prerequisites": [
          "Selected models and research plugins must be configured and available. Source-specific credentials/readiness remain declared by the selected source capabilities.",
          "Report output additionally requires sesame/reports, sesame/data-access, sesame/workspace and sesame/plugin-manager. Without a report these report dependencies are not required."
        ],
        "limitations": [
          "No broker/account binding, target portfolio, order, strategy change or schedule is created.",
          "Necessary missing evidence interrupts the same Run and retains accepted child identities and checkpoints; only unresolved members continue after resume.",
          "Only the manager publishes a requested report using existing evidence and the reports design rules. A completed result is reusable independently of its HTML.",
          "Bull, bear, risk and manager may ask original analysts targeted questions when answers can change the interpretation. Follow-up work reuses the analyst identity, selected model and frozen source permissions; no fixed count or forced consensus. Risk QA reaches manager, and manager QA remains in the final result.",
          "When a missing fact materially limits the judgment, use an existing verification outcome or a concrete capability/coverage limit to explain the boundary. If applicable analyst capabilities remain and no check was attempted, ask a targeted question; an inherited unknown is not proof of unavailability. Do not repeat failed acquisition without a new path or pursue nonessential completeness."
        ]
      },
      "binding": {
        "type": "native",
        "name": "investment_research_analyze"
      },
