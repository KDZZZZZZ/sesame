                    "type": "string",
                    "minLength": 1
                  },
                  "configurationDigest": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "provider",
                  "id"
                ],
                "additionalProperties": false
              },
              "news": {
                "type": "object",
                "properties": {
                  "provider": {
                    "type": "string",
                    "minLength": 1
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "configurationDigest": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
