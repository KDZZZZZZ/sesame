      "id": "investment_research_analyze",
      "description": "Research one investment question with selected sources and methods. Analysts, bull/bear, risk and manager share standards for a scoped main judgment, testable mechanisms, relevant theory and comparisons, competing explanations and evidence limits; methods and inquiry order follow the question. Targeted follow-up answers and fixed evidence remain in the result. No account or trading dependency. All downstream roles (bull, bear, risk, manager) can query the original analysts. start_from reruns a suffix from a completed fixed result without changing the original.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16000
          },
          "subjects": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "as_of": {
            "type": "string",
            "minLength": 1,
            "description": "Evidence publication/observation cutoff, preferably UTC ISO; omitted uses workflow creation time. Current research may collect after starting and must record actual retrieval time separately. Historical backtests or point-in-time claims require the historical data version, not later revisions."
          },
          "horizon": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "description": "Relevant investment horizon; not a trading schedule."
          },
          "research": {
            "type": "object",
            "properties": {
              "plugins": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "tools": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true,
                "description": "Exact declared capability IDs (pluginId#capabilityId preferred). Omitted selects delegatable research functions with no declared trading/configuration/process/workflow-control effects; [] loads knowledge only."
              }
            },
            "required": [
              "plugins"
            ],
            "additionalProperties": false
          },
          "model": {
            "type": "object",
            "properties": {
              "provider": {
                "type": "string",
                "minLength": 1
              },
              "id": {
                "type": "string",
                "minLength": 1
              },
              "configurationDigest": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "provider",
              "id"
            ],
            "additionalProperties": false
          },
          "agent_models": {
            "type": "object",
            "properties": {
              "market": {
                "type": "object",
                "properties": {
                  "provider": {
                    "type": "string",
                    "minLength": 1
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "configurationDigest": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "provider",
                  "id"
                ],
                "additionalProperties": false
              },
              "fundamentals": {
                "type": "object",
