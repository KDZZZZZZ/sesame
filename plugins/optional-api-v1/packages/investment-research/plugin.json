{
  "id": "sesame/investment-research",
  "apiVersion": "2",
  "version": "4.0.1",
  "title": "投资研究 · Research",
  "description": "投资研究工作流：按问题选用 Research 方法与专业知识、取得证据、综合判断并交付统一视觉报告；复用原生 Run 与固定成果。",
  "license": "MIT",
  "default_state": "discoverable",
  "agent_scope": "all",
  "entry": "index.js",
  "engines": {
    "sesame": ">=0.3.0-dev.2 <0.4.0"
  },
  "capability_manifest": "capabilities.json",
  "permissions": {
    "scopes": [
      "capabilities.compose"
    ],
    "calls": [
      "host.agent.run",
      "host.runs.read",
      "host.runs.wait",
      "host.runs.interrupt",
      "host.resources.read",
      "host.reports.describe",
      "host.reports.publish"
    ]
  }
}
