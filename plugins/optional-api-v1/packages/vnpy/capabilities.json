{
  "schemaVersion": 1,
  "apiVersion": "2",
  "configSchema": {
    "type": "object",
    "properties": {},
    "required": [],
    "additionalProperties": false
  },
  "capabilities": [
    {
      "id": "vnpy_environment",
      "kind": "function",
      "consumers": [
        "agent",
        "host"
      ],
      "description": "Inspect existing native Python/VeighNa environments; prepare first reuses a compatible environment and installs pinned dependencies in private plugin data only when needed. No download occurs on plugin load or inspect. Runs managed host processes, not an OS sandbox.",
      "inputSchema": {
        "type": "object",
        "required": [
          "action"
        ],
        "properties": {
          "action": {
            "anyOf": [
              {
                "type": "string",
                "const": "inspect"
              },
              {
                "type": "string",
                "const": "prepare"
              }
            ]
          },
          "python_path": {
            "type": "string",
            "description": "Existing native Python executable to inspect or use for a private environment",
            "minLength": 1,
            "maxLength": 20000
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": true
      },
      "execution": "run",
      "effects": [
        "process",
        "private-filesystem",
        "plugin.state.write",
        "network-on-prepare"
      ],
      "usage": {
        "purpose": "核验/选择实际VeighNa环境，或有界准备私有依赖。",
        "inputs": "{action:\"inspect\",python_path?} 核验显式/已选/宿主Python；{action:\"prepare\",python_path:<已知兼容或安装所用base路径>} 选择现有环境或准备私有依赖。最小例 {action:\"inspect\"}。",
        "outputs": "成功:{ready:true,reused,configured,environment:{python,packages,origin,downloads,...},findings}；缺失:{ready:false,requirements,findings,next}；准备中:{ready:false,configured:false,phase,progress,error,retryable,privateDirectory,cacheDirectory,next}。",
        "prerequisites": [
          "本机64位Python3.10–3.13；固定vnpy4.5.0/CTA1.4.1。ready:true且configured:false可对同一python prepare保存选择，不下载。"
        ],
        "limitations": [
          "prepare可能下载大Qt包；retryable:true且进度变化才有继续依据，使用相同base路径保留缓存。retryable:false停止自动重试；不换镜像/删除缓存来绕过失败。依赖就绪不代表策略回测成功。"
        ]
      },
      "binding": {
        "type": "native",
        "name": "vnpy_environment"
      }
    },
    {
      "id": "vnpy_backtest",
      "kind": "function",
      "consumers": [
        "agent",
        "host"
      ],
      "description": "Run actual VeighNa CTA BacktestingEngine on a fixed DataRef and one authored CtaTemplate Python file. Executes managed current-user host Python; preserves code, environment, parameters, matching assumptions and results. This is a bar backtest, not a live broker or SVL equivalence check.",
      "inputSchema": {
        "type": "object",
        "required": [
          "operation_id",
          "title",
          "data",
          "strategy_path",
          "class_name",
          "config"
        ],
        "properties": {
          "operation_id": {
            "type": "string",
            "description": "Idempotency key for this exact backtest",
            "minLength": 1,
            "maxLength": 20000
          },
          "title": {
            "type": "string",
            "description": "Result title",
            "minLength": 1,
            "maxLength": 20000
          },
          "data": {
            "type": "object",
            "required": [
              "id",
              "revision",
              "digest",
              "kind",
              "schemaVersion"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "revision": {
                "type": "string"
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "kind": {
                "type": "string",
                "const": "data"
              },
              "schemaVersion": {
                "type": "string",
                "const": "1.0.0"
              }
            },
            "additionalProperties": false
          },
          "strategy_path": {
            "type": "string",
            "description": "Workspace Python source file",
            "minLength": 1,
            "maxLength": 20000
          },
          "class_name": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "config": {
            "type": "object",
            "required": [
              "vt_symbol",
              "interval",
              "rate",
              "slippage",
              "size",
              "pricetick",
              "capital"
            ],
            "properties": {
              "vt_symbol": {
                "type": "string",
                "description": "symbol.Exchange, using a VeighNa Exchange enum",
                "minLength": 1,
                "maxLength": 20000
              },
              "interval": {
                "anyOf": [
                  {
                    "type": "string",
                    "const": "1m"
                  },
                  {
                    "type": "string",
                    "const": "1h"
                  },
                  {
                    "type": "string",
                    "const": "d"
                  },
                  {
                    "type": "string",
                    "const": "w"
                  }
                ]
              },
              "rate": {
                "type": "string",
                "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
              },
              "slippage": {
                "type": "string",
                "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
              },
              "size": {
                "type": "string",
                "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
              },
              "pricetick": {
                "type": "string",
                "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
              },
              "capital": {
                "type": "string",
                "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
              },
              "start": {
                "type": "string"
              },
              "end": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          "columns": {
            "type": "object",
            "properties": {
              "datetime": {
                "type": "string",
                "minLength": 1
              },
              "open": {
                "type": "string",
                "minLength": 1
              },
              "high": {
                "type": "string",
                "minLength": 1
              },
              "low": {
                "type": "string",
                "minLength": 1
              },
              "close": {
                "type": "string",
                "minLength": 1
              },
              "volume": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          },
          "wall_time_authority": {
            "type": "string",
            "description": "Required for offset-free timestamps; preserves their original authority without guessing UTC",
            "minLength": 1,
            "maxLength": 20000
          },
          "parameters": {
            "type": "object",
            "patternProperties": {
              "^.*$": {}
            }
          },
          "timeout": {
            "type": "integer",
            "minimum": 1,
            "maximum": 600
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": true
      },
      "execution": "run",
      "effects": [
        "process",
        "private-filesystem",
        "resources.publish",
        "plugin.state.write"
      ],
      "usage": {
        "purpose": "消费已有固定数据、策略和参数执行一次原生计算，交付结果ref、输入血缘、统计和诊断；候选选择、比较与综合由工作流负责。",
        "inputs": "{operation_id,title,data,strategy_path,class_name,config,parameters?,columns?,timeout?}。data 为 data_snapshot 等公开数据工具返回的固定 {id,revision,digest,kind:\"data\",schemaVersion:\"1.0.0\"}，内容为 json-rows；禁止猜引用/用可变datasetId代替。 strategy_path 是工作区真实单文件（≤512KiB），class_name 为已编写的CtaTemplate类名；输入2–100000行、≤16MiB，列默认datetime/open/high/low/close/volume，columns可改名，未知量不填0。config最小例 {vt_symbol:\"TEST.LOCAL\",interval:\"d\",rate:\"0.001\",slippage:\"0\",size:\"1\",pricetick:\"0.01\",capital:\"100000\"}；interval=1m|1h|d|w，start/end可限定；无时区时间必须给原始wall_time_authority。",
        "outputs": "{ref:<固定strategy.result>,status:\"completed\"|\"failed\",data:[{id:\"daily\"|\"trades\"|\"orders\",ref,rowCount}],statistics,diagnostics,executionRunId,nativeSource,environment,rawResult,execution:\"host\"}；failed没有成功表；中断保留unknown/运行操作记录，不自动重放。",
        "prerequisites": [
          "vnpy_environment ready:true 且 configured:true；固定数据和工作区代码来自本任务。公开 skill 给出原生接口/单位，无须阅读安装源码。"
        ],
        "limitations": [
          "执行当前用户权限的真实Python，宿主可取消但不是OS沙箱；引擎本身只使用固定数据，不连接实盘broker。",
          "operation_id绑定代码、数据、参数和撮合配置；相同输入重试读原结果，改变输入须新研究意图。失败读diagnostics；未知不声称完成。",
          "demo来源保持demo；completed只表示引擎完成，不证明盈利、SVL等价或实盘有效。原生浮点不具decimal34等价。"
        ]
      },
      "binding": {
        "type": "native",
        "name": "vnpy_backtest"
      }
    },
    {
      "id": "vnpy_result",
      "kind": "function",
      "consumers": [
        "agent",
        "host"
      ],
      "description": "Read one fixed VeighNa result manifest and the references needed for a report. Reading does not rerun strategies or place orders.",
      "inputSchema": {
        "type": "object",
        "required": [
          "ref"
        ],
        "properties": {
          "ref": {
            "type": "object",
            "required": [
              "id",
              "revision",
              "digest",
              "kind",
              "schemaVersion"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "revision": {
                "type": "string"
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "kind": {
                "type": "string",
                "const": "strategy.result"
              },
              "schemaVersion": {
                "type": "string",
                "const": "1.0.0"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": true
      },
      "execution": "immediate",
      "effects": [],
      "usage": {
        "purpose": "复用已冻结原生回测结果与输入/撮合假设；读取不重跑，也不自动另开报告。",
        "inputs": "{ref:<backtest返回的完整strategy.result引用>}；不传operation_id或工作区文件路径。",
        "outputs": "{ref,manifest}；manifest.content 含 status,title,engine,environment,assumptions,inputs,nativeSource,rawResult,data,statistics,limitations,provenance；表中ref可交data_read。",
        "prerequisites": [
          "已有固定strategy.result；此读取不需要Python/终端。"
        ],
        "limitations": [
          "读取不重跑回测；统计与输入范围、成本和demo标签一同解释。"
        ]
      },
      "binding": {
        "type": "native",
        "name": "vnpy_result"
      }
    },
    {
      "id": "vnpy_dispose",
      "kind": "function",
      "consumers": [
        "host"
      ],
      "description": "Close private plugin storage and owned resources.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": true
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "closed": {
            "const": true
          }
        },
        "required": [
          "closed"
        ],
        "additionalProperties": false
      },
      "execution": "immediate",
      "effects": [
        "plugin.session.close"
      ],
      "usage": {
        "purpose": "关闭插件自有资源。",
        "inputs": "宿主生命周期输入 {}。",
        "outputs": "{closed:true}。",
        "prerequisites": [
          "仅宿主卸载/关闭时调用。"
        ],
        "limitations": [
          "释放插件存储和自有会话/订阅；不删除已发布证据，不结束用户交易终端。"
        ]
      },
      "binding": {
        "type": "native",
        "name": "vnpy_dispose"
      }
    }
  ],
