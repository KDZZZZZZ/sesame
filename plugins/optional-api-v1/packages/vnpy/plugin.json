{
  "id": "sesame/vnpy",
  "title": "VeighNa CTA 回测",
  "description": "计算验证能力：消费固定数据与已编写CtaTemplate运行原生回测，交付可追溯结果与假设；候选比较由工作流负责，不连接实盘。",
  "version": "2.0.4",
  "apiVersion": "2",
  "license": "MIT",
  "default_state": "discoverable",
  "entry": "index.js",
  "prompts": [
    "prompt.md"
  ],
  "skills": [
    "skills"
  ],
  "resources": [
    "README.md",
    "requirements.txt",
    "runner.py",
    "examples/strategy.py",
    "examples/bars.json",
    "PROVENANCE.md"
  ],
  "engines": {
    "sesame": ">=0.3.0-dev.1 <0.4.0"
  },
  "capability_manifest": "capabilities.json",
  "permissions": {
    "scopes": [
      "process.execute"
    ],
    "calls": [
      "host.process.exec"
    ]
  }
}
