  "stateCollections": [],
  "artifactSchemas": [
    {
      "id": "data",
      "kind": "data",
      "schemaVersion": "1.0.0",
      "schema": {
        "type": "object",
        "properties": {
          "format": {
            "const": "json-rows"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "rowCount": {
            "type": "integer",
            "minimum": 0
          },
          "columns": {
            "type": "array"
          },
          "provenance": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "format",
          "path",
          "rowCount",
          "columns",
          "provenance"
        ],
        "additionalProperties": true
      }
    }
  ]
}
