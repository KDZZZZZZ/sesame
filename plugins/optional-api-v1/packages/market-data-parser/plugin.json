{
  "id": "sesame/market-data-parser",
  "apiVersion": "2",
  "version": "3.0.2",
  "title": "公开汇率解析",
  "description": "信息解析能力：解析已有exchangerate-api JSON或TCMB XML汇率，保留base/单位/买卖方向与筛选范围；不获取行情、不作交易判断。",
  "license": "MIT",
  "author": {
    "name": "Sesame"
  },
  "default_state": "discoverable",
  "agent_scope": "all",
  "execution": "native",
  "capability_manifest": "capabilities.json",
  "prompts": [],
  "skills": [
    "skills"
  ],
  "resources": [],
  "engines": {
    "sesame": ">=0.3.0-dev.1 <0.4.0"
  },
  "entry": "index.js",
  "permissions": {
    "scopes": [
      "process.execute"
    ],
    "calls": [
      "host.process.exec"
    ]
  }
}
