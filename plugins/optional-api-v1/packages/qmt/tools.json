[
  {
    "name": "qmt_environment",
    "description": "Inspect existing QMT configuration and Python paths without launching or downloading. verify imports the SDK explicitly; prepare first reuses an importable existing SDK and only then installs pinned wheels in a private Windows CPython 3.12 environment. Requires broker-authorized MiniQMT for later reads.",
    "parameters": {
      "type": "object",
      "required": [
        "action"
      ],
      "properties": {
        "action": {
          "anyOf": [
            {
              "type": "string",
              "const": "inspect"
            },
            {
              "type": "string",
              "const": "verify"
            },
            {
              "type": "string",
              "const": "prepare"
            }
          ]
        },
        "python_path": {
          "type": "string",
          "description": "Existing absolute Windows Python executable; prepare requires x64 CPython 3.12 if SDK is missing",
          "minLength": 1,
          "maxLength": 20000
        },
        "operation_id": {
          "type": "string",
          "description": "Required for explicit preparation; retry the same request with the same key",
          "minLength": 1,
          "maxLength": 20000
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "qmt_configure",
    "description": "Save exact existing QMT connection paths and the authorized mainland STOCK account. Uses revision and operation ID; does not launch, log in to or change the broker terminal. Obtain the actual localhost market port from the existing MiniQMT settings.",
    "parameters": {
      "type": "object",
      "required": [
        "operation_id",
        "expected_version",
        "changes"
      ],
      "properties": {
        "operation_id": {
          "type": "string",
          "description": "Idempotency key",
          "minLength": 1,
          "maxLength": 20000
        },
        "expected_version": {
          "type": "integer",
          "minimum": 1
        },
        "changes": {
          "type": "object",
          "properties": {
            "python_path": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "userdata_directory": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "account_id": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "broker": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "market_port": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                {
                  "type": "null"
                }
              ]
            },
            "sector": {
              "type": "string",
              "description": "Existing native stock catalog sector; default 沪深京A股",
              "minLength": 1,
              "maxLength": 20000
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "qmt_read",
    "description": "Perform fixed read-only XtQuant calls on the configured Windows MiniQMT. search/describe/quotes map mainland stocks; asset/positions query the configured STOCK account. orders/fills preserve native fields and cover only the current trading day. None is ambiguous and raises an error. This tool never submits or cancels orders; explicit main-conversation trading tools are separate. No transfer, script execution or terminal launch exists.",
    "parameters": {
      "type": "object",
      "required": [
        "action"
      ],
      "properties": {
        "action": {
          "anyOf": [
            {
              "type": "string",
              "const": "search"
            },
            {
              "type": "string",
              "const": "describe"
            },
            {
              "type": "string",
              "const": "quotes"
            },
            {
              "type": "string",
              "const": "asset"
            },
            {
              "type": "string",
              "const": "positions"
            },
            {
              "type": "string",
              "const": "orders"
            },
            {
              "type": "string",
              "const": "fills"
            }
          ]
        },
        "query": {
          "type": "string",
          "maxLength": 100
        },
        "symbols": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^\\d{6}\\.(SH|SZ|BJ)$"
          },
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true
        },
        "page": {
          "type": "object",
          "required": [
            "limit"
          ],
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            },
            "cursor": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "additionalProperties": false,
          "description": "search/positions/orders/fills use a frozen 60-second snapshot; default 200 rows, repeat unchanged filters with nextCursor"
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "qmt_download_history",
    "description": "Explicitly download a requested unadjusted daily stock range into the already configured MiniQMT data cache. This is a user-requested data preparation action, not an automatic startup download. Reuse local history first.",
    "parameters": {
      "type": "object",
      "required": [
        "symbol",
        "start",
        "end"
      ],
      "properties": {
        "symbol": {
          "type": "string",
          "pattern": "^\\d{6}\\.(SH|SZ|BJ)$"
        },
        "start": {
          "type": "string",
          "pattern": "^\\d{8}$"
        },
        "end": {
          "type": "string",
          "pattern": "^\\d{8}$"
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "qmt_order",
    "description": "Only after an explicit user instruction: submit a limit buy or sell for integer STOCK shares on the exact configured account/revision. Broker permission, T+1 available shares, lot rules, price limits and session rules govern acceptance; submitted does not mean filled. No automatic retry after an unknown outcome. Reuse operation_id for the exact same intent, inspect orders/fills first on failure.",
    "parameters": {
      "type": "object",
      "required": [
        "operation_id",
        "user_authorized",
        "account_id",
        "connection_revision",
        "symbol",
        "side",
        "shares",
        "price"
      ],
      "properties": {
        "operation_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,100}$"
        },
        "user_authorized": {
          "type": "boolean",
          "const": true
        },
        "account_id": {
          "type": "string",
          "description": "Exact authorized account ID",
          "minLength": 1,
          "maxLength": 20000
        },
        "connection_revision": {
          "type": "string",
          "description": "Exact configured connection revision",
          "minLength": 1,
          "maxLength": 20000
        },
        "symbol": {
          "type": "string",
          "pattern": "^\\d{6}\\.(SH|SZ|BJ)$"
        },
        "side": {
          "anyOf": [
            {
              "type": "string",
              "const": "buy"
            },
            {
              "type": "string",
              "const": "sell"
            }
          ]
        },
        "shares": {
          "type": "string",
          "pattern": "^[1-9]\\d*$"
        },
        "price": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d*)(\\.\\d+)?$"
        },
        "execution_guard": {
          "type": "object",
          "required": [
            "observed_at",
            "expires_at",
            "max_quote_age_ms",
            "max_quote_to_send_ms",
            "price_limit"
          ],
          "properties": {
            "observed_at": {
              "type": "integer",
              "minimum": 1
            },
            "expires_at": {
              "type": "integer",
              "minimum": 1
            },
            "max_quote_age_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5000
            },
            "max_quote_to_send_ms": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "price_limit": {
              "type": "string",
              "pattern": "^(0|[1-9]\\d*)(\\.\\d+)?$"
            }
          },
          "additionalProperties": false,
          "description": "Optional final-mile guard in the native worker: decision deadline, account/available shares/cash, fresh source timestamp and price boundary. No retry; submitted is not filled."
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "qmt_cancel",
    "description": "Only after an explicit user instruction: cancel a previously accepted Sesame order, or an unknown original intent recovered as one exact active native order. Reuse the exact account/revision; the native process verifies ID, account and original remark, and for retained intents also unique ownership, symbol, side, quantity and active status before cancellation. Unknown original orders are never resubmitted. A cancel request is not confirmation; query orders/fills.",
    "parameters": {
      "type": "object",
      "required": [
        "operation_id",
        "user_authorized",
        "account_id",
        "connection_revision",
        "original_operation_id",
        "order_id"
      ],
      "properties": {
        "operation_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,100}$"
        },
        "user_authorized": {
          "type": "boolean",
          "const": true
        },
        "account_id": {
          "type": "string",
          "description": "Exact authorized account ID",
          "minLength": 1,
          "maxLength": 20000
        },
        "connection_revision": {
          "type": "string",
          "description": "Exact configured connection revision",
          "minLength": 1,
          "maxLength": 20000
        },
        "original_operation_id": {
          "type": "string",
          "description": "Original qmt_order operation ID; unknown results require a retained intent and exact native recovery",
          "minLength": 1,
          "maxLength": 20000
        },
        "order_id": {
          "type": "string",
          "pattern": "^[1-9]\\d*$"
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "qmt_command",
    "description": "Read a stored QMT order/cancel receipt by operation_id without submitting or replaying it. outcome_unknown is unresolved even if a current-day search returns no match; inspect qmt_read orders/fills. This is not a live broker query.",
    "parameters": {
      "type": "object",
      "required": [
        "operation_id"
      ],
      "properties": {
        "operation_id": {
          "type": "string",
          "description": "Existing QMT operation ID",
          "minLength": 1,
          "maxLength": 20000
        }
      },
      "additionalProperties": false
    }
  }
]
