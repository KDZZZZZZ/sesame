{
  "analysis": [
    {
      "name": "catalog_search",
      "description": "Search QuantSkills catalog by keyword in name or description",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Keyword to search",
            "maxLength": 2000,
            "minLength": 1
          },
          "limit": {
            "type": "integer",
            "default": 20,
            "maximum": 100,
            "minimum": 1
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "catalog_filter",
      "description": "Filter catalog by category, workflow stage, asset type, or verification level",
      "inputSchema": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "description": "Category name (e.g. '02 因子研发工具箱')",
            "maxLength": 2000
          },
          "stage": {
            "type": "string",
            "description": "Workflow stage (e.g. 'data-ingestion')",
            "maxLength": 2000
          },
          "asset_type": {
            "type": "string",
            "description": "Asset type: skill, agent, template, infrastructure",
            "maxLength": 2000
          },
          "verification_level": {
            "type": "string",
            "description": "Verification level: published_endpoint, pending_review, unknown",
            "maxLength": 2000
          },
          "limit": {
            "type": "integer",
            "default": 50,
            "maximum": 1000,
            "minimum": 1
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "catalog_list_categories",
      "description": "List all categories with counts",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "catalog_get_item",
      "description": "Get full details of a catalog item by name",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Exact item name (repo name)",
            "maxLength": 2000,
            "minLength": 1
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "catalog_recommend",
      "description": "Route a user need to a single consolidated Sesame method workflow and appropriate backend choices. Availability is not checked; use the actual plugin catalog before installation.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "need": {
            "type": "string",
            "enum": [
              "market-data",
              "market-explanation",
              "technical-analysis",
              "strategy-research",
              "factor-research",
              "native-backtest",
              "report",
              "judgment-review"
            ]
          }
        },
        "required": [
          "need"
        ],
        "additionalProperties": false
      }
    }
  ]
}
