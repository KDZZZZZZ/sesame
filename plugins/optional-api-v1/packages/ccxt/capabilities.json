      "outputSchema": {
        "type": "object",
        "additionalProperties": true
      },
      "execution": "immediate",
      "effects": [
        "process",
        "network",
        "plugin.session.write"
      ],
      "usage": {
        "purpose": "为宿主持续提供初始行情快照及增量。",
        "inputs": "{binding:<bind结果>,query:{instrument:<search.ref>,spec:<describe支持的spec>,tailLimit:100,includeForming:true}}；不传历史range或复用分页cursor，tailLimit正整数≤500；恢复使用新快照。timeframe=1m|5m|15m|1h|1d，priceBasis=last，adjustment=none，session=all|default，calendarRevision:{status:\"unknown\"}。",
        "outputs": "{id,events:AsyncIterable,close}；首帧 {type:\"snapshot\",snapshot:{seriesId,instrument,spec,bars,coverage,meta?},position:{streamId,epoch,seq},consistency,recovery:\"snapshot\"}；后续 {streamId,epoch,seq,eventId,schemaVersion,observedAt,type,payload}，type 为 bars.upsert/bars.closed（按源能力）或 stream.gap。position/consistency/recovery 平铺在首帧，不嵌入 metadata。",
        "prerequisites": [
          "Agent 使用 data_providers({contract:\"sesame.market/1\"}) 返回的 sesame/ccxt#market 精确 ref，经 market_instruments 搜索/描述，再按任务使用 market_read 或 canvas_binding/canvas_apply；本 capability 仅供宿主数据适配层调用。",
          "ccxt_environment inspect 返回 ready:true 已保存选择；prepare 仅在依赖缺失时安装私有 CCXT 4.5.85。公开市场不需要 API Key。"
        ],
        "limitations": [
          "每次请求结束后至少1秒的公开轮询；不是交易所逐笔推送。",
          "订阅由宿主绑定、取消和释放，Agent 不持有 bindingId。stream.gap/RESYNC_REQUIRED 可按同一来源重新取得快照；具体 SCHEMA_MISMATCH 或首帧 position 缺失是协议问题，反复重绑、新建图或启用无关服务不能修复。",
          "coverage.complete:false 表示覆盖未获证明，可使用已返回的真实行并保留限制，不能改成 true 或当作空数据/请求失败。历史查询成功不证明实时订阅或图表渲染成功。"
        ]
      },
      "binding": {
        "type": "native",
        "name": "market_subscribeBars"
      },
      "transport": "subscription"
    },
