                      "ask",
                      "mid",
                      "last"
                    ]
                  },
                  "adjustment": {
                    "enum": [
                      "none",
                      "forward",
                      "backward"
                    ]
                  },
                  "session": {
                    "type": "string",
                    "minLength": 1
                  },
                  "calendarRevision": {
                    "type": "object",
                    "additionalProperties": true
                  }
                },
                "required": [
                  "timeframe",
                  "priceBasis",
                  "adjustment",
                  "session",
                  "calendarRevision"
                ],
                "additionalProperties": false
              },
              "tailLimit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2000
              },
              "includeForming": {
                "type": "boolean"
              },
              "resumeToken": {
                "type": "string",
                "minLength": 1
              }
