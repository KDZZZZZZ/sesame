        ],
        "additionalProperties": false
      },
      "execution": "immediate",
      "effects": [
        "plugin.session.close"
      ],
      "usage": {
        "purpose": "关闭插件自有资源。",
        "inputs": "宿主生命周期输入 {}。",
        "outputs": "{closed:true}。",
        "prerequisites": [
          "仅宿主卸载/关闭时调用。"
        ],
        "limitations": [
          "释放插件存储和自有会话/订阅；不删除已发布证据，不结束用户交易终端。"
        ]
      },
      "binding": {
        "type": "native",
        "name": "ccxt_dispose"
      }
    }
