          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]{16,128}$"
        },
        "expected_version": {
          "type": "integer",
          "minimum": 0,
          "description": "kurumi_status返回的控制revision，新挑战用0"
        },
        "max_steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5000,
          "description": "本次最多付费角色决定数，省略1；多步需要用户已授权"
        }
      },
      "required": [
        "command_id",
        "expected_version"
      ],
      "additionalProperties": false
    }
  },
