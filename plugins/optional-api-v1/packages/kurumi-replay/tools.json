  {
    "name": "kurumi_configure",
    "label": "kurumi_configure",
    "description": "主Agent调整角色决策间隔：1或4个交易小时（新挑战默认4）；无任务在跑（含未核对角色任务/恢复/自动延续）时才可改，幂等与版本不丢。4h表示每4根可交易H1一次真实角色决定，末章不足4根提前结算；只改图表周期不算完成。",
    "parameters": {
      "type": "object",
      "properties": {
        "command_id": {
          "type": "string",
          "description": "精确操作幂等ID；重试保持同ID与参数",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]{16,128}$"
        },
        "expected_version": {
          "type": "integer",
          "minimum": 0,
          "description": "kurumi_status返回的控制revision"
        },
        "decision_interval_hours": {
          "type": "integer",
          "enum": [
            1,
            4
          ],
          "description": "1=每根H1一次角色决定；4=每4根可交易H1一次角色决定"
        }
      },
      "required": [
        "command_id",
        "expected_version",
        "decision_interval_hours"
      ],
      "additionalProperties": false
    }
  },
