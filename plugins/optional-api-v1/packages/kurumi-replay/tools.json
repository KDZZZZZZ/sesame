  {
    "name": "kurumi_decide",
    "label": "kurumi_decide",
    "description": "角色专用：本步一次目标仓位（基础货币整数，1000倍数；负空、正多、0平仓）或明确hold。提交后下一根真实bid/ask开盘执行，不保证止损成交价。",
    "parameters": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string",
          "description": "observe返回runId",
          "minLength": 1,
          "maxLength": 128
        },
        "step_id": {
          "type": "string",
          "description": "observe返回stepId",
          "minLength": 1,
          "maxLength": 128
        },
        "expected_version": {
          "type": "integer",
          "minimum": 1
        },
        "target": {
          "type": "string",
          "pattern": "^(0|-?[1-9][0-9]{0,7})$",
          "description": "带符号基础货币整数，1000倍数，最大绝对值10000000"
        },
        "stop": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9]+(\\.[0-9]+)?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "type": "string",
          "description": "只基于当前证据的交易理由",
          "minLength": 1,
          "maxLength": 1500
        },
        "utterance": {
          "type": "string",
          "description": "简短原创角色短句",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "run_id",
        "step_id",
        "expected_version",
        "target",
        "stop",
        "reason",
        "utterance"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "kurumi_recover",
    "label": "kurumi_recover",
    "description": "主Agent核对真实旧任务终态及本步未提交后，用已保存的原决定执行一个真实H1；不请求模型、不伪造角色身份。",
    "parameters": {
      "type": "object",
      "properties": {
        "command_id": {
          "type": "string",
          "description": "精确操作幂等ID；重试保持同ID与参数",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]{16,128}$"
        },
        "expected_version": {
          "type": "integer",
          "minimum": 0,
          "description": "kurumi_status返回的控制revision，新挑战用0"
        },
        "decision_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "failed_not_committed证据中的原decision.id"
        }
      },
      "required": [
        "command_id",
        "expected_version",
        "decision_id"
      ],
      "additionalProperties": false
    }
  }
