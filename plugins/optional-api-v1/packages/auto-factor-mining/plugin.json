{
  "id": "sesame/auto-factor-mining",
  "apiVersion": "2",
  "version": "2.0.0",
  "title": "因子研究",
  "description": "按策略需求查库、补评或搜索因子；使用真实 Qlib、DEAP 与 Optuna，在固定数据和纯因子评价上保存独立证据。策略通过明确决策维护自己的因子池。",
  "author": {
    "name": "Sesame contributors"
  },
  "license": "MIT",
  "default_state": "discoverable",
  "agent_scope": "all",
  "entry": "index.js",
  "engines": {
    "sesame": ">=0.3.0-dev.2 <0.4.0"
  },
  "capability_manifest": "capabilities.json",
  "permissions": {
    "scopes": [
      "capabilities.compose",
      "process.execute"
    ],
    "calls": [
      "host.process.exec",
      "sesame/auto-factor-mining#factor_workflow",
      "host.reports.publish",
      "sesame/reports#report_check",
      "host.reports.describe"
    ]
  }
}
