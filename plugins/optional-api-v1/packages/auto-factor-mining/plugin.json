{
  "id": "sesame/auto-factor-mining",
  "apiVersion": "2",
  "version": "1.1.8",
  "title": "自动因子挖掘",
  "description": "因子挖掘、候选信号与因子组合的多轮实验工作流：组合技术知识、数据来源、计算能力和独立 evaluator，组织假设、实测、复核与选择。公开入口 auto_factor_start；工作流不限定品种数量，具体数据形状与指标由所选 evaluator 决定。",
  "author": {
    "name": "Sesame contributors"
  },
  "license": "MIT",
  "default_state": "discoverable",
  "agent_scope": "all",
  "entry": "index.js",
  "engines": {
    "sesame": ">=0.3.0-dev.1 <0.4.0"
  },
  "capability_manifest": "capabilities.json",
  "permissions": {
    "scopes": [
      "capabilities.compose",
      "plugins.manage"
    ],
    "calls": [
      "host.agent.run",
      "host.runs.read",
      "host.runs.wait",
      "host.runs.interrupt",
      "host.resources.read",
      "sesame/reports#report_document_template",
      "sesame/reports#report_publish",
      "sesame/reports#report_check",
      "sesame/workspace#write"
    ]
  }
}
