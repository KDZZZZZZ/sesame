              "evaluator"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "request_id",
          "title",
          "goal",
          "config"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "ownerConversationId": {
            "type": "string"
          },
          "config": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": true
          },
          "data": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": true
          },
          "tasks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {},
              "required": [],
              "additionalProperties": true
            }
          },
          "trials": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {},
              "required": [],
              "additionalProperties": true
            }
          }
        },
        "required": [
          "id",
          "status"
        ],
        "additionalProperties": true
      },
      "execution": "immediate",
      "effects": [
        "write:research-checkpoints",
        "invoke:selected-evaluator",
        "start:workflow"
      ],
      "usage": {
        "purpose": "Start a workflow with an explicitly selected independent evaluator {plugin_id,tool,arguments?}, configured role models and arbitrary selected research plugins/tools. No evaluator or execution backend is implicit. Evaluator owns data format, calculations and gates. With general research capabilities only development-only evidence is accepted; no holdout claim. Each task run produces one final summary.",
        "inputs": "{request_id,title,goal,dataset_id?,config:{model,evaluator:{plugin_id,tool,arguments?},research:{plugins,tools?},...bounded research limits}}. Known evaluator: {plugin_id:\"sesame/factor-evaluator\",tool:\"factor_evaluate\",arguments:{dataset:{trainEnd,validationEnd,holdoutEnd,horizon,costBps,quantile},minRankIC,minCoverage,maxCorrelation}}. Its registered dataset rows are {time,symbol,availableAt,fields:{close,...numeric features}}; other protocol implementations may declare other formats.",
        "outputs": "Saved business run with id/status, frozen evaluator/input digest/development contract and workflow Run reference when admitted. Stable request_id and identical input reuse the run. auto_factor_runs(action:\"read\",run_id:id) supplies actual progress/result.",
        "prerequisites": [
          "Main conversation only; task/tool names do not grant a delegated Agent this authority.",
          "Explicitly enabled evaluator implementing sesame.factor-evaluator/v1 and configured role models. This plugin does not provide a dataset or silently select/install an evaluator.",
          "Installed implementations: plugin_discover and host.capabilities.list. Published optional packages: plugin_catalog({plugin_id}); installation/loading is a separate public operation."
        ],
        "limitations": [
          "Any general research tools imply development-only access; the bundled evaluator then rejects rows beyond validationEnd and makes no holdout claim.",
          "Starting schedules real Agent calls within rounds/maxTrials/maxTasks/taskTimeoutMs limits. Queued/running is not research completion."
        ]
      },
      "binding": {
        "type": "native",
        "name": "auto_factor_start"
      }
    },
    {
      "id": "auto_factor_runs",
      "kind": "function",
      "consumers": [
        "agent",
        "host"
      ],
      "description": "List/read persisted research runs or forward pause/resume/cancel to their original host Run. Saved role identities and stage outputs are retained; finished runs cannot be resumed.",
      "inputSchema": {
        "type": "object",
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "action": {
                "const": "list"
              }
            },
            "required": [
              "action"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "action": {
                "const": "read"
              },
              "run_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "required": [
              "action",
              "run_id"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "action": {
                "const": "pause"
              },
              "run_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "required": [
              "action",
              "run_id"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "action": {
                "const": "resume"
              },
              "run_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "interrupt_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "response": {}
            },
            "required": [
              "action",
              "run_id",
              "interrupt_ids"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "action": {
                "const": "cancel"
              },
              "run_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "required": [
              "action",
              "run_id"
            ],
            "additionalProperties": false
          }
        ]
      },
      "outputSchema": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "runs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "status"
                  ],
                  "additionalProperties": true
                }
              }
            },
            "required": [
              "runs"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "status": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "status"
            ],
            "additionalProperties": true
          }
        ]
      },
      "execution": "immediate",
      "effects": [
        "read:research-checkpoints",
        "write:research-checkpoints",
        "control:workflow"
      ],
      "usage": {
        "purpose": "List/read persisted research runs or forward pause/resume/cancel to their original host Run. Saved role identities and stage outputs are retained; finished runs cannot be resumed.",
        "inputs": "action=list, or read/pause/cancel with run_id (business ID from start). For resume, read returns pending interrupts with id/reason/requirements; after resolving the selected items, call {action:\"resume\",run_id,interrupt_ids:[\"returned ID\"],response?:JSON}. Always select IDs explicitly, including a single interrupt.",
        "outputs": "list => {runs}; read/control => saved run with status,phase,tasks,trials,selection,reflections,report and errors. read includes current pending interrupts. The separate workflow reference identifies the original host Run.",
        "prerequisites": [
          "Main conversation only; task/tool names do not grant a delegated Agent this authority.",
          "Resume follows the host control contract: the main Agent must be responding to a user reply received after interruption. Select only the resolved interrupt IDs; a tool argument cannot create this authorization."
        ],
        "limitations": [
          "Pause acceptance is not safe-point completion; read reveals actual interrupted status. Resume resolves only the supplied interrupt_ids, rechecks dependencies and resumes the same Run/session when no unresolved items remain. It does not create a generation or reopen selection. Cancelled, failed and exhausted runs are terminal."
        ]
      },
      "binding": {
        "type": "native",
        "name": "auto_factor_runs"
      }
    },
    {
      "id": "auto_factor_context",
      "kind": "function",
      "consumers": [
        "agent",
        "host"
      ],
      "description": "Read the current assigned role, output contract, frozen dataset description, paginated development rows, peer outputs, experiments and reflections. Research roles never receive holdout observations. Follow nextOffset for complete evidence.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "run_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "section": {
            "type": "string",
            "enum": [
              "team",
              "data",
              "memory"
            ]
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": [
          "run_id"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": true
      },
      "execution": "immediate",
      "effects": [
        "write:consumed-output-checkpoint"
      ],
      "usage": {
        "purpose": "Read the current assigned role, output contract, frozen dataset description, paginated development rows, peer outputs, experiments and reflections. Research roles never receive holdout observations. Follow nextOffset for complete evidence.",
        "inputs": "{run_id,section?:\"team\"|\"data\"|\"memory\",offset?:0,limit?:20}; use the business run ID in task input.",
        "outputs": "{runId,goal,status,config,data,assignment:{role,mode,expectedOutput,...},evaluator,holdoutMode,...}; data rows, trials/team or memory have {items,total,nextOffset}. expectedOutput is the current submission shape.",
        "prerequisites": [
          "Owning main or registered role task for this run."
        ],
        "limitations": [
          "All returned rows are development observations. Reading peers exposes their saved outputs, not hidden holdout data."
        ]
      },
      "binding": {
        "type": "native",
        "name": "auto_factor_context"
      }
    },
    {
      "id": "auto_factor_submit",
      "kind": "function",
      "consumers": [
        "agent",
        "host"
      ],
      "description": "Save one immutable role output. Candidates are opaque JSON defined by the selected evaluator. Candidate and selection submissions invoke that evaluator and save its actual receipt; Agent-supplied metrics are never accepted.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "run_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "output": {
            "type": "object",
            "description": "Role output as JSON, at most 16000 UTF-8 bytes. Reflection accepts {summary:string,lessons:string[],stop?:boolean}: summary is nonempty and at most 4000 characters; lessons may be empty, with each nonempty string at most 1000 characters and no item-count limit. Omitted reflection stop defaults to false; only true ends later research rounds. The plan role still requires its explicit stop boolean. Other role shapes are described in usage.inputs and assignment.expectedOutput.",
            "additionalProperties": true
          }
        },
        "required": [
          "run_id",
          "output"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": true
      },
      "execution": "immediate",
      "effects": [
        "write:research-checkpoints",
        "invoke:selected-evaluator"
      ],
      "usage": {
        "purpose": "Save one immutable role output. Candidates are opaque JSON defined by the selected evaluator. Candidate and selection submissions invoke that evaluator and save its actual receipt; Agent-supplied metrics are never accepted.",
        "inputs": "{run_id,output:<assignment.expectedOutput>}; plan={directions:string[],stop:boolean,reason:string}; hypothesis={hypothesis:string,rationale:string,parentId?:string} or {skip:true,reason:string}. parentId may only reference an existing trial from an earlier round; omit it in round 0 or for an independent hypothesis, never use the current trial ID. code={candidate,explanation:string}; review={verdict:\"accept\"|\"reject\",reason:string}; reflection={summary:string,lessons:string[],stop?:boolean}: summary is required, nonempty and at most 4000 characters; lessons is a required array (possibly empty), each nonempty string at most 1000 characters, with no item-count limit. Reflection stop defaults to false when omitted, continuing within the configured rounds and budget; only explicit true stops later research. selection={trialIds:string[],reason:string}. Every output is limited to 16000 UTF-8 bytes of JSON. Candidate format comes from context.evaluator/expectedOutput.",
        "outputs": "Saved immutable role output; reflection includes stop:false when omitted and retains every submitted lesson. code/selection additionally contain the actual evaluator receipt in evaluation, including measured metrics/eligibility or exact selected IDs/digest.",
        "prerequisites": [
          "Current registered role task; active run and matching assignment mode."
        ],
        "limitations": [
          "Select only accepted eligible trials; [] is valid if none qualifies. Metrics supplied by a model are not measurement.",
          "EVALUATION_REJECTED permits correcting an uncommitted proposal. Unknown/interrupted evaluation keeps the original pending input for identical retry."
        ]
      },
      "binding": {
        "type": "native",
        "name": "auto_factor_submit"
      }
    },
    {
      "id": "auto_factor_report",
      "kind": "function",
      "consumers": [
        "agent",
        "host"
      ],
      "description": "Read the final report artifact already published by this workflow. Report publication happens inside the workflow after its actual child Runs settle; this read never recreates moved, edited or deleted user files.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "run_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "run_id"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": true
      },
      "execution": "immediate",
      "effects": [],
      "usage": {
        "purpose": "Read the final report artifact already published by this workflow. Report publication happens inside the workflow after its actual child Runs settle; this read never recreates moved, edited or deleted user files.",
        "inputs": "{run_id:<business run ID>}.",
        "outputs": "{ref:<published report ArtifactRef>,receipt,entry:\"report.html\",attachments:[{path,mediaType}],state:\"published\"}; read the exact ref manifest/content for report.html and frozen run.json. REPORT_UNAVAILABLE means no final artifact was published; inspect the saved run state.",
        "prerequisites": [
          "Owning main/authorized task and a workflow report that actually exists."
        ],
        "limitations": [
          "This does not create a second report or restore user-deleted files. The report's holdoutMode limits performance claims."
        ]
      },
      "binding": {
        "type": "native",
        "name": "auto_factor_report"
      }
    },
    {
      "id": "auto_factor_activity",
      "kind": "function",
      "consumers": [
        "agent",
        "host"
      ],
      "description": "Open this workflow execution in the native Run graph, with child Agents and its published report.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "run_id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "run_id"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": true
      },
      "execution": "immediate",
      "effects": [
        "open:native-run-view"
      ],
      "usage": {
        "purpose": "Open this workflow execution in the native Run graph, with child Agents and its published report.",
        "inputs": "{run_id:<business run ID>}.",
        "outputs": "Native view-open receipt for the stored workflow Run, including child Agents and final report.",
        "prerequisites": [
          "Main conversation only; task/tool names do not grant a delegated Agent this authority.",
          "The workflow has been admitted and has a Run reference."
        ],
        "limitations": [
          "Opening a view does not run or resume research."
        ]
      },
      "binding": {
        "type": "native",
        "name": "auto_factor_activity"
      }
    },
    {
      "id": "auto_factor_workflow",
      "kind": "workflow",
      "consumers": [
        "host"
      ],
      "description": "Execute the saved factor workflow. Research roles use host.agent.run; evaluation and publication use native code.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "run_id": {
            "type": "string"
          }
        },
        "required": [
          "run_id"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "runId": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "report": {
            "type": [
              "object",
              "null"
            ]
          }
        },
        "required": [
          "runId",
          "status",
          "report"
        ],
        "additionalProperties": false
      },
      "execution": "run",
