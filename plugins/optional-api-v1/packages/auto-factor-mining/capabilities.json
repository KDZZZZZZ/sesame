        "type": "object",
        "properties": {
          "request_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "goal": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "dataset_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "config": {
            "type": "object",
            "properties": {
              "model": {
                "type": "object",
                "properties": {
                  "provider": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "configurationDigest": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                },
                "required": [
                  "provider",
                  "id"
                ],
                "additionalProperties": false
              },
              "agentModels": {
                "type": "object",
                "properties": {
                  "supervisor": {
                    "type": "object",
                    "properties": {
                      "provider": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      },
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      },
                      "configurationDigest": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      }
                    },
                    "required": [
                      "provider",
                      "id"
                    ],
                    "additionalProperties": false
                  },
                  "researcher": {
                    "type": "object",
                    "properties": {
                      "provider": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      },
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      },
                      "configurationDigest": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      }
                    },
                    "required": [
                      "provider",
                      "id"
                    ],
                    "additionalProperties": false
                  },
                  "coder": {
                    "type": "object",
                    "properties": {
                      "provider": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      },
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      },
                      "configurationDigest": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      }
                    },
                    "required": [
                      "provider",
                      "id"
                    ],
                    "additionalProperties": false
                  },
                  "reviewer": {
                    "type": "object",
                    "properties": {
                      "provider": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      },
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      },
                      "configurationDigest": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      }
                    },
                    "required": [
                      "provider",
                      "id"
                    ],
                    "additionalProperties": false
                  },
                  "reflector": {
                    "type": "object",
                    "properties": {
                      "provider": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      },
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      },
                      "configurationDigest": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      }
                    },
                    "required": [
                      "provider",
                      "id"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [],
                "additionalProperties": false
              },
              "directions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "minItems": 1,
                "maxItems": 6,
                "uniqueItems": true
              },
              "rounds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10
              },
              "maxTrials": {
                "type": "integer",
                "minimum": 1,
                "maximum": 40
              },
              "parallelism": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3
              },
              "maxTasks": {
                "type": "integer",
                "minimum": 4,
                "maximum": 200
              },
              "taskTimeoutMs": {
                "type": "integer",
                "minimum": 30000,
                "maximum": 1800000
              },
              "research": {
                "type": "object",
                "properties": {
                  "plugins": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 150
                    },
                    "maxItems": 32,
                    "uniqueItems": true
                  },
                  "tools": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 150
                    },
                    "maxItems": 61,
                    "uniqueItems": true,
                    "description": "Explicit qualified capability IDs pluginId#capabilityId from the selected manifests; omitted selects declared Agent-consumable capabilities."
                  }
                },
                "required": [
                  "plugins"
                ],
                "additionalProperties": false
              },
              "evaluator": {
                "type": "object",
                "properties": {
                  "plugin_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 150
                  },
                  "tool": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 150
                  },
                  "arguments": {
                    "type": "object",
                    "additionalProperties": true
                  }
                },
                "required": [
                  "plugin_id",
                  "tool"
                ],
                "additionalProperties": false
              }
            },
            "required": [
