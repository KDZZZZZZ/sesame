  "capabilities": [
    {
      "id": "auto_factor_models",
      "kind": "function",
      "consumers": [
        "agent",
        "host"
      ],
      "description": "List configured provider/model descriptors and factor-mining roles. Select a default model and optionally a different model for each role.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "models": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "configurationDigest": {
                  "type": "string"
                }
              },
              "required": [
                "provider",
                "id",
                "configurationDigest"
              ],
              "additionalProperties": true
            }
          },
          "roles": {
            "type": "array",
            "items": {
              "enum": [
                "supervisor",
                "researcher",
                "coder",
                "reviewer",
                "reflector"
              ]
            }
          }
        },
        "required": [
          "models",
          "roles"
        ],
        "additionalProperties": false
      },
      "execution": "immediate",
      "effects": [],
      "usage": {
        "purpose": "List configured provider/model descriptors and factor-mining roles. Select a default model and optionally a different model for each role.",
        "inputs": "{}.",
        "outputs": "{models:[configured descriptors],roles:[supervisor,researcher,coder,reviewer,reflector,...]}; use exact provider/id/configurationDigest.",
        "prerequisites": [
          "Main conversation only; task/tool names do not grant a delegated Agent this authority."
        ],
        "limitations": [
          "Credentials are not returned; a configured model has not yet performed research."
        ]
      },
      "binding": {
        "type": "native",
        "name": "auto_factor_models"
      }
    },
    {
      "id": "auto_factor_start",
      "kind": "function",
      "consumers": [
        "agent",
        "host"
      ],
      "description": "Start a workflow with an explicitly selected independent evaluator {plugin_id,tool,arguments?}, configured role models and arbitrary selected research plugins/tools. No evaluator or execution backend is implicit. Evaluator owns data format, calculations and gates. With general research capabilities only development-only evidence is accepted; no holdout claim. Each task run produces one final summary.",
