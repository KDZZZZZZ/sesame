  {
    "name": "auto_factor_runs",
    "description": "List/read persisted research runs or pause, explicitly resume, or cancel one. Resume uses saved stage outputs, never reopens frozen selection. Agent calls have a fixed task budget; cancelled and exhausted runs are terminal.",
    "parameters": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "list",
            "read",
            "pause",
            "resume",
            "cancel"
          ]
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "action"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "auto_factor_context",
    "description": "Read the current assigned role, output contract, frozen dataset description, paginated development rows, peer outputs, experiments and reflections. Research roles never receive holdout observations. Follow nextOffset for complete evidence.",
    "parameters": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "section": {
          "type": "string",
          "enum": [
            "team",
            "data",
            "memory"
          ]
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "required": [
        "run_id"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "auto_factor_submit",
    "description": "Save one immutable role output. Candidates are opaque JSON defined by the selected evaluator. Candidate and selection submissions invoke that evaluator and save its actual receipt; Agent-supplied metrics are never accepted.",
    "parameters": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "output": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": [
        "run_id",
        "output"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "auto_factor_report",
    "description": "Publish the single final summary for completed/cancelled/exhausted work after all research tasks settle, with frozen dataset/factor/evidence JSON under research/自动因子挖掘. Paused, interrupted and failed resumable work stays in the live ledger. Main Agent can retry pending summaries; moved, edited or deleted files are respected.",
    "parameters": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "run_id"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "auto_factor_activity",
    "description": "Open real collaboration HTML in Sesame’s report panel, or read the current snapshot for an owned factor run. Host SSE forwards real task/tool states, public messages and successful shared-output reads into the isolated HTML. Opening never starts Agents, advances research or writes report files. Each completed task run has one final summary.",
    "parameters": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "action": {
          "type": "string",
          "enum": [
            "open",
            "read"
          ]
        }
      },
      "required": [
        "run_id"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "auto_factor_finalize",
    "description": "Registered finalizer only: call the selected evaluator for the already-frozen selection, save its final evidence, and return a bounded receipt. Does not change the candidate set or publish an extra report.",
    "parameters": {
      "type": "object",
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        }
      },
      "required": [
        "run_id"
      ],
      "additionalProperties": false
    }
  }
]
