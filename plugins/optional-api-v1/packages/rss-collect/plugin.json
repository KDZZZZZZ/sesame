{
  "id": "sesame/rss-collect",
  "apiVersion": "2",
  "version": "3.0.2",
  "title": "RSS / Atom 解析",
  "description": "信息解析能力：从已有完整RSS/Atom XML提取有限条目与原始日期；不获取文章全文、不判断新闻影响，供方法与工作流复用原证据。",
  "license": "MIT",
  "author": {
    "name": "Sesame"
  },
  "default_state": "discoverable",
  "agent_scope": "all",
  "execution": "native",
  "capability_manifest": "capabilities.json",
  "prompts": [],
  "skills": [
    "skills"
  ],
  "resources": [],
  "engines": {
    "sesame": ">=0.3.0-dev.1 <0.4.0"
  },
  "entry": "index.js",
  "permissions": {
    "scopes": [
      "process.execute"
    ],
    "calls": [
      "host.process.exec"
    ]
  }
}
