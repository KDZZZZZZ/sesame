{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/KDZZZZZZ/sesame/main/plugins/catalog.schema.json",
  "title": "Sesame plugin catalog v1",
  "type": "object",
  "required": ["schemaVersion", "updatedAt", "plugins"],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": 1},
    "updatedAt": {"type": "string", "format": "date-time"},
    "plugins": {"type": "array", "minItems": 1, "maxItems": 2000, "items": {"$ref": "#/$defs/plugin"}}
  },
  "$defs": {
    "localized": {"type": "object", "required": ["en", "zh"], "additionalProperties": false, "properties": {"en": {"type": "string", "minLength": 1, "maxLength": 500}, "zh": {"type": "string", "minLength": 1, "maxLength": 500}}},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "plugin": {
      "type": "object",
      "required": ["id", "name", "version", "kind", "title", "summary", "category", "author", "license", "minAppVersion", "source", "package", "status", "review", "tools", "requirements", "feedbackUrl"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*$"},
        "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "version": {"$ref": "#/$defs/version"},
        "kind": {"enum": ["bundled", "installable"], "description": "bundled loads the installed app plugin only. installable permits a verified standard MCP package; a compatible bundled copy is preferred."},
        "title": {"$ref": "#/$defs/localized"}, "summary": {"$ref": "#/$defs/localized"},
        "category": {"enum": ["research", "data", "workspace", "strategy", "mt5"]},
        "author": {"type": "object", "required": ["name", "url"], "properties": {"name": {"type": "string"}, "url": {"type": "string", "format": "uri"}}},
        "license": {"type": "string", "minLength": 1},
        "minAppVersion": {"$ref": "#/$defs/version"},
        "bundledPluginId": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "source": {"type": "object", "required": ["repository", "commit", "path"], "properties": {"repository": {"const": "https://github.com/KDZZZZZZ/sesame"}, "commit": {"$ref": "#/$defs/commit"}, "path": {"type": "string", "pattern": "^plugins/packages/"}}},
        "package": {"type": "object", "required": ["treeDigest", "files"], "properties": {
          "treeDigest": {"$ref": "#/$defs/sha256", "description": "SHA256 of compact JSON array of [path, 'sha256:'+fileDigest], sorted by path using JavaScript string order."},
          "files": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"type": "object", "required": ["path", "sha256", "bytes"], "properties": {"path": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha256"}, "bytes": {"type": "integer", "minimum": 0, "maximum": 2097152}}}}
        }},
        "status": {"enum": ["active", "withdrawn"]},
        "withdrawalReason": {"type": "string"},
        "review": {"type": "object", "required": ["automated", "human"], "properties": {"automated": {"const": "catalog-ci"}, "human": {"enum": ["not-recorded", "approved"]}, "notes": {"type": "string"}, "reference": {"type": "string", "format": "uri"}, "reviewer": {"type": "string"}, "reviewedCommit": {"$ref": "#/$defs/commit"}}},
        "tools": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "requirements": {"$ref": "#/$defs/localized"},
        "feedbackUrl": {"type": "string", "format": "uri"},
        "documentationUrl": {"type": "string", "format": "uri"}
      }
    }
  }
}
