[
  {
    "name": "data_read",
    "label": "data_read",
    "description": "列出真实输入与已登记结果（包括 MT5 响应快照）。提供 dataset_id 后把完整数据复制为执行目录的 inputs/<id>.json，返回有界样本与来源。大数据用沙箱代码提取字段或统计，勿整文件读回模型；查询新行情使用 MT5 官方工具。",
    "parameters": {
      "type": "object",
      "properties": {
        "dataset_id": {
          "type": "string",
          "description": "数据 ID，不填列目录",
          "minLength": 1,
          "maxLength": 20000
        },
        "directory": {
          "type": "string",
          "description": "执行目录，默认 /work；与 bash.cwd 一致时可分析大型持久工作区中的单个项目",
          "minLength": 1,
          "maxLength": 20000
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "research_register",
    "label": "research_register",
    "description": "把本会话成功 bash 执行产生的 JSON 对象数组登记为后端数据。只接受 execution 的冻结输出，不接受手填 rows。",
    "parameters": {
      "type": "object",
      "required": [
        "execution_id",
        "path",
        "title",
        "description",
        "input_ids"
      ],
      "properties": {
        "execution_id": {
          "type": "string",
          "description": "成功执行 ID",
          "minLength": 1,
          "maxLength": 20000
        },
        "path": {
          "type": "string",
          "description": "该执行输出文件，如 output/result.json",
          "minLength": 1,
          "maxLength": 20000
        },
        "title": {
          "type": "string",
          "description": "结果名称",
          "minLength": 1,
          "maxLength": 20000
        },
        "description": {
          "type": "string",
          "description": "统计口径、单位和局限",
          "minLength": 1,
          "maxLength": 20000
        },
        "input_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "输入数据 ID",
            "minLength": 1,
            "maxLength": 20000
          },
          "minItems": 1,
          "maxItems": 20
        },
        "recipe_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "执行快照中必要的脚本/配置相对路径；动态导入或动态文件名需要显式列出，其他草稿会清理",
            "minLength": 1,
            "maxLength": 20000
          },
          "maxItems": 128
        }
      },
      "additionalProperties": false
    }
  }
]
