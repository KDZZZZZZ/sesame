[
  {
    "name": "mt5_catalog",
    "label": "mt5_catalog",
    "description": "读取 MT5 官方能力的当前目录、inputSchema、工作区权限及不可用原因。先发现后调用；query 可过滤方法名。Python 仅提供官方 API，不能执行任意代码。",
    "parameters": {
      "type": "object",
      "properties": {
        "server": {
          "anyOf": [
            {
              "type": "string",
              "const": "terminal"
            },
            {
              "type": "string",
              "const": "metaeditor"
            },
            {
              "type": "string",
              "const": "marketdata"
            },
            {
              "type": "string",
              "const": "python"
            },
            {
              "type": "string",
              "const": "launcher"
            }
          ]
        },
        "query": {
          "type": "string",
          "description": "过滤方法名或说明",
          "minLength": 1,
          "maxLength": 20000
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "mt5_call",
    "label": "mt5_call",
    "description": "调用 mt5-official 所属的官方能力。先从 mt5_catalog 获取精确 tool / inputSchema；其他插件的方法不能从此入口调用。command_id 沿用同一动作的稳定 ID；结果 unknown 时先核对真实状态。save_as 可保存大 JSON。",
    "parameters": {
      "type": "object",
      "required": [
        "server",
        "tool",
        "arguments",
        "command_id"
      ],
      "properties": {
        "server": {
          "anyOf": [
            {
              "type": "string",
              "const": "terminal"
            },
            {
              "type": "string",
              "const": "metaeditor"
            },
            {
              "type": "string",
              "const": "marketdata"
            },
            {
              "type": "string",
              "const": "python"
            },
            {
              "type": "string",
              "const": "launcher"
            }
          ]
        },
        "tool": {
          "type": "string",
          "description": "目录返回的精确方法名",
          "minLength": 1,
          "maxLength": 20000
        },
        "arguments": {
          "type": "object",
          "properties": {},
          "additionalProperties": true
        },
        "command_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{16,128}$",
          "description": "唯一稳定 ID，推荐 UUID；同一动作重试必须沿用"
        },
        "save_as": {
          "type": "string",
          "description": "完整结果的 /work JSON 文件路径",
          "minLength": 1,
          "maxLength": 20000
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "mt5_cache",
    "label": "mt5_cache",
    "description": "管理与交易面板共用的本地 MT5 行情库。bars/trades 只读本地；sync/sync_trades 从当前已验证账户下载并去重保存；时间是券商墙上时间的秒值，不代表 UTC。大结果使用 save_as。remove 只清理指定品种周期的行情。",
    "parameters": {
      "type": "object",
      "required": [
        "action"
      ],
      "properties": {
        "action": {
          "anyOf": [
            {
              "type": "string",
              "const": "symbols"
            },
            {
              "type": "string",
              "const": "inventory"
            },
            {
              "type": "string",
              "const": "bars"
            },
            {
              "type": "string",
              "const": "sync"
            },
            {
              "type": "string",
              "const": "trades"
            },
            {
              "type": "string",
              "const": "sync_trades"
            },
            {
              "type": "string",
              "const": "remove"
            }
          ]
        },
        "symbol": {
          "type": "string",
          "description": "精确品种",
          "minLength": 1,
          "maxLength": 20000
        },
        "period": {
          "type": "string",
          "description": "MT5 周期，如 H1",
          "minLength": 1,
          "maxLength": 20000
        },
        "from": {
          "type": "integer"
        },
        "to": {
          "type": "integer"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20000
        },
        "save_as": {
          "type": "string",
          "description": "完整 JSON 的沙箱路径",
          "minLength": 1,
          "maxLength": 20000
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "mt5_command",
    "label": "mt5_command",
    "description": "读取本会话已有调用的结果；不会重发终端操作。returned 只表示收到官方响应，仍需检查 isError、retcode、Tester 状态。",
    "parameters": {
      "type": "object",
      "required": [
        "command_id"
      ],
      "properties": {
        "command_id": {
          "type": "string",
          "description": "已有 command_id",
          "minLength": 1,
          "maxLength": 20000
        }
      },
      "additionalProperties": false
    }
  }
]
