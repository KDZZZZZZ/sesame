      "type": "object",
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "type": "string",
          "description": "HTTP/HTTPS URL，不得包含凭据",
          "minLength": 1,
          "maxLength": 20000
        }
      },
      "additionalProperties": false
    }
  }
]
