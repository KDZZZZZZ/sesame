{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sesame official plugin bundle lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "apiVersion", "channel", "packages"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "apiVersion": { "const": "1" },
    "channel": { "enum": ["development", "stable"] },
    "packages": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "version", "directory", "treeDigest", "files"],
        "properties": {
          "id": { "type": "string", "pattern": "^sesame/[a-z][a-z0-9-]*$" },
          "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
          "directory": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "treeDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "files": {
            "type": "array", "minItems": 1, "maxItems": 1024,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["path", "sha256", "bytes"],
              "properties": {
                "path": { "type": "string", "minLength": 1, "maxLength": 512 },
                "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                "bytes": { "type": "integer", "minimum": 0, "maximum": 2097152 }
              }
            }
          }
        }
      }
    }
  }
}
