            "type": "string",
            "description": "真实回测任务 ID",
            "minLength": 1,
            "maxLength": 20000
          },
          "minItems": 1,
          "maxItems": 32
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "mt5_trade_detail",
    "label": "mt5_trade_detail",
    "description": "读取原生历史回测的成交与真实票据关联 trace。旧 visual-mql-v1 图保留原身份；没有真实映射时明确返回 unavailable，不将其标为 SVL 验证。",
    "parameters": {
      "type": "object",
      "required": [
        "trade_id"
      ],
      "properties": {
        "trade_id": {
          "type": "string",
          "description": "回测数据集中的成交 ID",
          "minLength": 1,
          "maxLength": 20000
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "mt5_target",
    "label": "mt5_target",
    "description": "读取并冻结 MQL5 目标 profile、数值/事件/恢复限制及包内翻译说明。先保存 SVL 并由宿主从源生成图，再依目标翻译；本工具不编译、不回测、不交易。",
    "parameters": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  },
  {
    "name": "mt5_translation",
    "label": "mt5_translation",
    "description": "将 Agent 按冻结 SVL 源编写的 MQL5 文件、逐节点 source_map 与适配说明登记为翻译成果和独立 MT5 工程。只检查身份与映射结构；结果 partial，不证明原生语义等价。逻辑变化先修 SVL，再创建新翻译。",
    "parameters": {
      "type": "object",
      "required": [
        "operation_id",
        "title",
        "source",
        "target",
        "mode",
        "parameter_map",
        "files",
        "source_map",
        "adaptations"
      ],
      "properties": {
        "operation_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{16,128}$"
        },
        "title": {
          "type": "string",
          "description": "工程名称",
          "minLength": 1,
          "maxLength": 20000
        },
        "source": {
          "type": "object",
          "required": [
            "id",
            "revision",
            "digest",
            "kind",
            "schemaVersion"
          ],
          "properties": {
            "id": {
              "type": "string",
              "description": "成果 ID",
              "minLength": 1,
              "maxLength": 20000
            },
            "revision": {
              "type": "string",
              "description": "固定修订",
              "minLength": 1,
              "maxLength": 20000
            },
            "digest": {
              "type": "string",
              "description": "sha256 摘要",
              "minLength": 1,
              "maxLength": 20000
            },
            "kind": {
              "type": "string",
              "description": "成果类型",
              "minLength": 1,
              "maxLength": 20000
            },
            "schemaVersion": {
              "type": "string",
              "const": "1.0.0"
            }
          },
          "additionalProperties": false
        },
        "target": {
          "type": "object",
          "required": [
            "id",
            "revision",
            "digest",
            "kind",
            "schemaVersion"
          ],
          "properties": {
            "id": {
              "type": "string",
              "description": "成果 ID",
              "minLength": 1,
              "maxLength": 20000
            },
            "revision": {
              "type": "string",
              "description": "固定修订",
              "minLength": 1,
              "maxLength": 20000
            },
            "digest": {
              "type": "string",
              "description": "sha256 摘要",
              "minLength": 1,
              "maxLength": 20000
            },
            "kind": {
              "type": "string",
              "description": "成果类型",
              "minLength": 1,
              "maxLength": 20000
            },
            "schemaVersion": {
              "type": "string",
              "const": "1.0.0"
            }
          },
          "additionalProperties": false
        },
        "mode": {
          "anyOf": [
            {
              "type": "string",
              "const": "backtest"
            },
            {
              "type": "string",
              "const": "live"
            }
          ]
        },
        "parameter_map": {
          "type": "object",
          "patternProperties": {
            "^.*$": {
              "anyOf": [
                {
                  "type": "object",
                  "required": [
                    "nativeInput"
                  ],
                  "properties": {
                    "nativeInput": {
                      "type": "string",
                      "description": "实际 MQL5 input 参数名",
                      "minLength": 1,
                      "maxLength": 20000
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "required": [
                    "binding"
                  ],
                  "properties": {
                    "binding": {
                      "anyOf": [
                        {
                          "type": "string",
                          "const": "instrument"
                        },
                        {
                          "type": "string",
                          "const": "account"
                        }
                      ]
                    }
                  },
                  "additionalProperties": false
                }
              ]
            }
          }
        },
        "files": {
          "type": "object",
          "patternProperties": {
            "^.*$": {
              "type": "string",
              "maxLength": 1048576
            }
          },
          "maxProperties": 128
        },
        "source_map": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "nodeId",
              "generated",
              "instrumentation"
            ],
            "properties": {
              "nodeId": {
                "type": "string",
                "description": "实际 SVL 节点 ID",
                "minLength": 1,
                "maxLength": 20000
              },
              "generated": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "path",
                    "startLine",
                    "endLine"
                  ],
                  "properties": {
                    "path": {
                      "type": "string",
                      "description": "实际相对路径",
                      "minLength": 1,
                      "maxLength": 20000
                    },
                    "startLine": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "endLine": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "additionalProperties": false
                }
              },
              "instrumentation": {
                "anyOf": [
                  {
                    "type": "string",
                    "const": "direct"
                  },
                  {
                    "type": "string",
                    "const": "inlined"
                  },
                  {
                    "type": "string",
                    "const": "boundary"
                  },
                  {
                    "type": "string",
                    "const": "unobservable"
                  }
                ]
              },
              "reason": {
                "type": "string",
                "description": "不可观测原因",
                "minLength": 1,
                "maxLength": 20000
              }
            },
            "additionalProperties": false
          },
          "maxItems": 1000
        },
        "adaptations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "code",
              "nodes",
              "status",
              "description",
              "evidence"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "适配代码",
                "minLength": 1,
                "maxLength": 20000
              },
              "nodes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "description": "实际源节点 ID",
                  "minLength": 1,
                  "maxLength": 20000
                }
              },
              "status": {
                "anyOf": [
                  {
                    "type": "string",
                    "const": "equivalent"
                  },
                  {
                    "type": "string",
                    "const": "limited"
                  },
                  {
                    "type": "string",
                    "const": "unsupported"
                  }
                ]
              },
              "description": {
                "type": "string",
                "description": "具体语义差异及限制",
                "minLength": 1,
                "maxLength": 20000
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "revision",
                    "digest",
                    "kind",
                    "schemaVersion"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "description": "成果 ID",
                      "minLength": 1,
                      "maxLength": 20000
                    },
                    "revision": {
                      "type": "string",
                      "description": "固定修订",
                      "minLength": 1,
                      "maxLength": 20000
                    },
                    "digest": {
                      "type": "string",
                      "description": "sha256 摘要",
                      "minLength": 1,
                      "maxLength": 20000
                    },
                    "kind": {
                      "type": "string",
                      "description": "成果类型",
                      "minLength": 1,
                      "maxLength": 20000
                    },
                    "schemaVersion": {
                      "type": "string",
                      "const": "1.0.0"
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          },
          "maxItems": 1000
        }
      },
      "additionalProperties": false
    }
  }
]
