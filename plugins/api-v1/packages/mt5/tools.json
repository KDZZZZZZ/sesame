  {
    "name": "mt5_project",
    "label": "mt5_project",
    "description": "管理独立 MQL5 工程。create 创建 visual-mql-v1 空骨架；先读 visual-state-machines skill 和语言参考。save 严格解析、检查类型/效果/预算，并从同一 IR 生成原生代码与图；源码诊断是可恢复工具错误。旧工程继续按原模板编辑。草稿不能回测。",
    "parameters": {
      "type": "object",
      "required": [
        "action"
      ],
      "properties": {
        "action": {
          "anyOf": [
            {
              "type": "string",
              "const": "list"
            },
            {
              "type": "string",
              "const": "create"
            },
            {
              "type": "string",
              "const": "checkout"
            },
            {
              "type": "string",
              "const": "save"
            },
            {
              "type": "string",
              "const": "configure_risk"
            }
          ]
        },
        "title": {
          "type": "string",
          "description": "新工程名称",
          "minLength": 1,
          "maxLength": 20000
        },
        "project_id": {
          "type": "string",
          "description": "工程 ID",
          "minLength": 1,
          "maxLength": 20000
        },
        "checkout_id": {
          "type": "string",
          "description": "当前会话 checkout ID",
          "minLength": 1,
          "maxLength": 20000
        },
        "expected_version": {
          "type": "integer",
          "minimum": 1
        },
        "test_risk_limits": {
          "type": "object",
          "required": [
            "max_risk_per_trade_pct",
            "max_daily_loss_pct",
            "max_open_positions",
            "max_lots"
          ],
          "properties": {
            "max_risk_per_trade_pct": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "max_daily_loss_pct": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "max_open_positions": {
              "type": "integer",
              "minimum": 1
            },
            "max_lots": {
              "type": "string",
              "maxLength": 24
            }
          },
          "additionalProperties": false,
          "description": "configure_risk 由主 Agent 按用户任务修改；仅影响随后创建的测试，既有构建和任务保留冻结参数"
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "mt5_inspect",
    "label": "mt5_inspect",
    "description": "查看本机能力、工程源码及生成逻辑摘要、冻结构建诊断。engine_node_id 可按源节点下钻到输入、调用目标和源码。checked 表示严格源码已校验；declared 只是旧工程手写声明；均不代表 Tester 已通过。",
    "parameters": {
      "type": "object",
      "properties": {
        "project_id": {
          "type": "string",
          "description": "工程 ID",
          "minLength": 1,
          "maxLength": 20000
        },
        "build_id": {
          "type": "string",
          "description": "构建 ID",
          "minLength": 1,
          "maxLength": 20000
        },
        "engine_node_id": {
          "type": "string",
          "description": "严格工程中需要展开的节点 ID；必须同时给出 project_id 或 build_id",
          "minLength": 1,
          "maxLength": 20000
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "mt5_compile",
    "label": "mt5_compile",
    "description": "冻结已保存 revision、平台 SDK 和本机标准库，在隔离 Wine 环境调用 MetaEditor。成功返回 EX5 摘要；失败作为可恢复工具错误返回构建 ID、诊断与修复指引，修改 checkout 并 save 新 revision 后重试。不执行 EA。",
    "parameters": {
      "type": "object",
      "required": [
        "project_id",
        "revision"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "description": "工程 ID",
          "minLength": 1,
          "maxLength": 20000
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "description": "明确指定已保存的源码版本"
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "mt5_settings",
    "label": "mt5_settings",
    "description": "读取 MT5 脱敏连接、账户绑定、环境与待导入凭据引用。不会登录、启动终端或交易。",
    "parameters": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  },
  {
    "name": "mt5_update_configuration",
    "label": "mt5_update_configuration",
    "description": "按用户任务修改 MT5 连接、原生设置或普通运行选项。先读取版本；密钥通过 mt5_import_configuration 的安全引用导入。",
    "parameters": {
      "type": "object",
      "required": [
        "command_id",
        "expected_version",
        "changes"
      ],
      "properties": {
        "command_id": {
          "type": "string",
          "minLength": 16,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "expected_version": {
          "type": "integer",
          "minimum": 1
        },
        "changes": {
          "anyOf": [
            {
              "type": "object",
              "required": [
                "import_native"
              ],
              "properties": {
                "import_native": {
                  "type": "boolean",
                  "const": true
                }
              },
              "additionalProperties": false,
              "minProperties": 1
            },
            {
              "type": "object",
              "properties": {
                "allow_trading": {
                  "type": "boolean"
                },
                "allow_host_operations": {
                  "type": "boolean"
                },
                "servers": {
                  "type": "object",
                  "properties": {
                    "terminal": {
                      "type": "object",
                      "properties": {
                        "url": {
                          "type": "string",
                          "maxLength": 2048,
                          "pattern": "^[^\\r\\n\\u0000]*$"
                        },
                        "enabled": {
                          "type": "boolean"
                        }
                      },
                      "additionalProperties": false,
                      "minProperties": 1
                    },
                    "metaeditor": {
                      "type": "object",
                      "properties": {
                        "url": {
                          "type": "string",
                          "maxLength": 2048,
                          "pattern": "^[^\\r\\n\\u0000]*$"
                        },
                        "enabled": {
                          "type": "boolean"
                        }
                      },
                      "additionalProperties": false,
                      "minProperties": 1
                    },
                    "marketdata": {
                      "type": "object",
                      "properties": {
                        "url": {
                          "type": "string",
                          "maxLength": 2048,
                          "pattern": "^[^\\r\\n\\u0000]*$"
                        },
                        "enabled": {
                          "type": "boolean"
                        }
                      },
                      "additionalProperties": false,
                      "minProperties": 1
                    }
                  },
                  "additionalProperties": false,
                  "minProperties": 1
                },
                "account": {
                  "type": "object",
                  "properties": {
                    "login": {
                      "type": "string",
                      "pattern": "^(|[1-9][0-9]{0,19})$"
                    },
                    "server": {
                      "type": "string",
                      "maxLength": 200,
                      "pattern": "^[^\\r\\n\\u0000]*$"
                    }
                  },
                  "additionalProperties": false,
                  "minProperties": 1
                },
                "tester_agent": {
                  "type": "object",
                  "properties": {
                    "address": {
                      "type": "string",
                      "maxLength": 15,
                      "pattern": "^[^\\r\\n\\u0000]*$"
                    },
                    "port": {
                      "type": "integer",
                      "minimum": 1024,
                      "maximum": 65535
                    }
                  },
                  "additionalProperties": false,
                  "minProperties": 1
                }
              },
              "additionalProperties": false,
              "minProperties": 1
            }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "mt5_import_configuration",
    "label": "mt5_import_configuration",
    "description": "导入主会话用户直接提供的 MT5 MCP 配置引用，密钥只在插件后台传递。只保存 Terminal/MetaEditor 连接，随后 mt5_connect 核验账户；MetaEditor 用目录单独核验。",
    "parameters": {
      "type": "object",
      "required": [
        "command_id",
        "source_message_id",
        "expected_version"
      ],
      "properties": {
        "command_id": {
          "type": "string",
          "minLength": 16,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "source_message_id": {
          "type": "string",
          "pattern": "^msg_[A-Za-z0-9_-]{1,100}$"
        },
        "expected_version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "mt5_connect",
    "label": "mt5_connect",
    "description": "验证并恢复已配置的 MT5 Terminal 连接。connected 只证明终端及绑定账户通过核验；不切换账户、不重放交易。不读取或返回秘密。",
    "parameters": {
      "type": "object",
      "required": [
        "command_id"
      ],
      "properties": {
        "command_id": {
          "type": "string",
          "minLength": 16,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "start_if_needed": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "mt5_report_data",
    "label": "mt5_report_data",
    "description": "从实际已结束的 MT5 Tester 任务发布可供通用报告引用的数据集。保留失败/取消状态、券商时间、费用和原生 trace 局限；不会启动回测。",
    "parameters": {
      "type": "object",
      "required": [
        "backtest_ids"
      ],
      "properties": {
        "backtest_ids": {
          "type": "array",
