[
  {
    "name": "read",
    "label": "read",
    "description": "读取工作区文件或已挂载插件的授权资源；文本默认最多 2000 行/50 KB，可用 offset/limit 继续读取。PNG/JPEG/GIF/WebP 作为图片返回。",
    "parameters": {
      "type": "object",
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "description": "工作区文件路径或宿主返回的插件资源路径",
          "minLength": 1,
          "maxLength": 20000
        },
        "offset": {
          "type": "integer",
          "minimum": 1
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "write",
    "label": "write",
    "description": "写入 UTF-8 工作区文件并创建所需父目录。",
    "parameters": {
      "type": "object",
      "required": [
        "path",
        "content"
      ],
      "properties": {
        "path": {
          "type": "string",
          "description": "工作区路径",
          "minLength": 1,
          "maxLength": 20000
        },
        "content": {
          "type": "string",
          "maxLength": 1048576
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "edit",
    "label": "edit",
    "description": "精确替换原文件中唯一且互不重叠的文本；全部匹配通过后一次写入。保留 BOM 和原换行风格。",
    "parameters": {
      "type": "object",
      "required": [
        "path",
        "edits"
      ],
      "properties": {
        "path": {
          "type": "string",
          "description": "工作区路径",
          "minLength": 1,
          "maxLength": 20000
        },
        "edits": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "oldText",
              "newText"
            ],
            "properties": {
              "oldText": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1048576
              },
              "newText": {
                "type": "string",
                "maxLength": 1048576
              }
            },
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 128
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "bash",
    "label": "bash",
    "description": "在本机工作区运行 shell：Windows 使用 PowerShell，其他平台使用 Bash；以当前系统用户权限运行，不是 OS 沙箱。返回真实执行 ID、cwd、退出码和有界输出尾部。非零退出、超时、输出超限或取消仍是工具错误，保留执行 ID 与已捕获输出供核验后重试。snapshot_errors非空表示冻结证据不完整，不能宣称可复现。",
    "parameters": {
      "type": "object",
      "required": [
        "command"
      ],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100000
        },
        "timeout": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600
        },
        "cwd": {
          "type": "string",
          "maxLength": 1000
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "host_files_list",
    "label": "host_files_list",
    "description": "只读列出宿主目录中的普通文件和目录；结果有界且可分页，遵循文件端口的应用私有区保护。",
    "parameters": {
      "type": "object",
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "宿主绝对路径；支持 ~/"
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "host_files_search",
    "label": "host_files_search",
    "description": "在宿主目录中按文件名片段递归搜索；不执行内容，不递归跟随符号链接。",
    "parameters": {
      "type": "object",
      "required": [
        "path",
        "query"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "宿主绝对路径；支持 ~/"
        },
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "host_files_read",
    "label": "host_files_read",
    "description": "只读读取宿主普通文件，每次最多 256 KiB；支持按字节分页，二进制返回 base64。",
    "parameters": {
      "type": "object",
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "宿主绝对路径；支持 ~/"
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 262144
        },
        "encoding": {
          "anyOf": [
            {
              "type": "string",
              "const": "utf8"
            },
            {
              "type": "string",
              "const": "base64"
            }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "host_files_import",
    "label": "host_files_import",
    "description": "将不超过 8 MiB 的宿主普通文件复制到当前工作区 inputs，保留原文件并登记来源和哈希。",
    "parameters": {
      "type": "object",
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "宿主绝对路径；支持 ~/"
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "host_files_write",
    "label": "host_files_write",
    "description": "在宿主写入不超过 8 MiB 的普通文件；覆盖需显式 overwrite，可用完整文件哈希防止覆盖已变化的内容。",
    "parameters": {
      "type": "object",
      "required": [
        "path",
        "content"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "宿主绝对路径；支持 ~/"
        },
        "content": {
          "type": "string",
          "maxLength": 12582912
        },
        "encoding": {
          "anyOf": [
            {
              "type": "string",
              "const": "utf8"
            },
            {
              "type": "string",
              "const": "base64"
            }
          ]
        },
        "overwrite": {
          "type": "boolean"
        },
        "expected_sha256": {
          "type": "string",
          "pattern": "^(sha256:)?[a-f0-9]{64}$",
          "description": "预期完整文件 SHA-256；不要使用分页片段的哈希代替完整文件哈希。"
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "host_files_mkdir",
    "label": "host_files_mkdir",
    "description": "在宿主递归创建所需目录，保留已存在目录。",
    "parameters": {
      "type": "object",
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "宿主绝对路径；支持 ~/"
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "host_files_move",
    "label": "host_files_move",
    "description": "在同一文件系统移动一个宿主普通文件到不存在的目标；不覆盖已有目标，跨文件系统需明确复制并核验。",
    "parameters": {
      "type": "object",
      "required": [
        "path",
        "destination"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "宿主绝对路径；支持 ~/"
        },
        "destination": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "宿主绝对路径；支持 ~/"
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "host_files_remove",
    "label": "host_files_remove",
    "description": "删除一个宿主普通文件或空目录；不会递归删除目录树，可用完整文件哈希检查目标。",
    "parameters": {
      "type": "object",
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "宿主绝对路径；支持 ~/"
        },
        "expected_sha256": {
          "type": "string",
          "pattern": "^(sha256:)?[a-f0-9]{64}$",
          "description": "预期完整文件 SHA-256；不要使用分页片段的哈希代替完整文件哈希。"
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "host_files_run",
    "label": "host_files_run",
    "description": "以当前系统用户权限在宿主运行明确的非交互命令，支持已有环境与按需依赖安装。此工具使用真实宿主权限、不自动 sudo；参数逐项传入，输出有界，超时或任务停止会取消子进程。",
    "parameters": {
      "type": "object",
      "required": [
        "argv",
        "cwd"
      ],
      "properties": {
        "argv": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 32768
          },
          "minItems": 1,
          "maxItems": 256
        },
        "cwd": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "宿主绝对路径；支持 ~/"
        },
        "timeout": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600,
          "description": "秒"
        },
        "env": {
          "type": "object",
          "patternProperties": {
            "^[A-Za-z_][A-Za-z0-9_]*$": {
              "type": "string",
              "maxLength": 32768
            }
          }
        }
      },
      "additionalProperties": false
    }
  }
]
