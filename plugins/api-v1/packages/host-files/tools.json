[
  {
    "name": "host_files_list",
    "label": "host_files_list",
    "description": "只读列出宿主目录中的普通文件和目录；结果有界且可分页，遵循文件端口的应用私有区保护。",
    "parameters": {
      "type": "object",
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "宿主绝对路径；支持 ~/"
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "host_files_search",
    "label": "host_files_search",
    "description": "在宿主目录中按文件名片段递归搜索；不执行内容，不递归跟随符号链接。",
    "parameters": {
      "type": "object",
      "required": [
        "path",
        "query"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "宿主绝对路径；支持 ~/"
        },
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "host_files_read",
    "label": "host_files_read",
    "description": "只读读取宿主普通文件，每次最多 256 KiB；支持按字节分页，二进制返回 base64。",
    "parameters": {
      "type": "object",
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "宿主绝对路径；支持 ~/"
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 262144
        },
        "encoding": {
          "anyOf": [
            {
              "type": "string",
              "const": "utf8"
            },
            {
              "type": "string",
              "const": "base64"
            }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "host_files_import",
    "label": "host_files_import",
    "description": "将不超过 8 MiB 的宿主普通文件复制到当前工作区 inputs，保留原文件并登记来源和哈希。",
    "parameters": {
      "type": "object",
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "宿主绝对路径；支持 ~/"
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "host_files_write",
    "label": "host_files_write",
    "description": "在宿主写入不超过 8 MiB 的普通文件；覆盖需显式 overwrite，可用完整文件哈希防止覆盖已变化的内容。",
    "parameters": {
      "type": "object",
      "required": [
        "path",
        "content"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "宿主绝对路径；支持 ~/"
        },
        "content": {
          "type": "string",
          "maxLength": 12582912
        },
        "encoding": {
          "anyOf": [
            {
              "type": "string",
              "const": "utf8"
            },
            {
              "type": "string",
              "const": "base64"
            }
          ]
        },
        "overwrite": {
          "type": "boolean"
        },
        "expected_sha256": {
          "type": "string",
          "pattern": "^(sha256:)?[a-f0-9]{64}$",
          "description": "预期完整文件 SHA-256；不要使用分页片段的哈希代替完整文件哈希。"
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "host_files_mkdir",
    "label": "host_files_mkdir",
    "description": "在宿主递归创建所需目录，保留已存在目录。",
    "parameters": {
      "type": "object",
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "宿主绝对路径；支持 ~/"
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "host_files_move",
    "label": "host_files_move",
    "description": "在同一文件系统移动一个宿主普通文件到不存在的目标；不覆盖已有目标，跨文件系统需明确复制并核验。",
    "parameters": {
      "type": "object",
      "required": [
        "path",
        "destination"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "宿主绝对路径；支持 ~/"
        },
        "destination": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "宿主绝对路径；支持 ~/"
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "host_files_remove",
    "label": "host_files_remove",
    "description": "删除一个宿主普通文件或空目录；不会递归删除目录树，可用完整文件哈希检查目标。",
    "parameters": {
      "type": "object",
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "宿主绝对路径；支持 ~/"
        },
        "expected_sha256": {
          "type": "string",
          "pattern": "^(sha256:)?[a-f0-9]{64}$",
          "description": "预期完整文件 SHA-256；不要使用分页片段的哈希代替完整文件哈希。"
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "host_files_run",
    "label": "host_files_run",
    "description": "以当前系统用户权限在宿主运行明确的非交互命令，支持已有环境与按需依赖安装。此工具使用真实宿主权限、不自动 sudo；参数逐项传入，输出有界，超时或任务停止会取消子进程。",
    "parameters": {
      "type": "object",
      "required": [
        "argv",
        "cwd"
      ],
      "properties": {
        "argv": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 32768
          },
          "minItems": 1,
          "maxItems": 256
        },
        "cwd": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "description": "宿主绝对路径；支持 ~/"
        },
        "timeout": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600,
          "description": "秒"
        },
        "env": {
          "type": "object",
          "patternProperties": {
            "^[A-Za-z_][A-Za-z0-9_]*$": {
              "type": "string",
              "maxLength": 32768
            }
          }
        }
      },
      "additionalProperties": false
    }
  }
]
