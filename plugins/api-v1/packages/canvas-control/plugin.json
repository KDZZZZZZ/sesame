{
  "id": "sesame/canvas-control",
  "title": "工作台与图表编排",
  "description": "主 Agent 编排水平工作台窗口，以及图表区内部的行情图、实时指标和研究曲线。",
  "version": "4.0.0",
  "default_state": "discoverable",
  "agent_scope": "main",
  "entry": "index.js",
  "prompts": [
    "prompt.md"
  ],
  "skills": [
    "skills"
  ],
  "apiVersion": "2",
  "mcp_export": [
    "canvas_inspect",
    "canvas_binding",
    "canvas_recover_source",
    "canvas_apply",
    "canvas_focus",
    "chart_script",
    "chart_drawing",
    "indicator_publish"
  ],
  "license": "MIT",
  "resources": [
    "resources/close-line.json",
    "resources/close-line.js",
    "resources/indicator-publish.json"
  ],
  "engines": {
    "sesame": ">=0.3.0-dev.1 <0.4.0"
  },
  "execution": "native",
  "capability_manifest": "capabilities.json",
  "permissions": {
    "scopes": [
      "capabilities.compose"
    ],
    "calls": []
  }
}
