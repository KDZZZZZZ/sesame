{
  "schemaVersion": 1,
  "apiVersion": "2",
  "configSchema": {
    "type": "object",
    "properties": {},
    "required": [],
    "additionalProperties": false
  },
  "capabilities": [
    {
      "id": "memory_search",
      "kind": "function",
      "consumers": [
        "agent",
        "host"
      ],
      "description": "检索长期记忆摘要，可按主题和资料范围筛选。默认包含归档，排除过期事实；检索不会刷新采用时间，也不授予权限。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "中文或其他语言关键词",
            "minLength": 1,
            "maxLength": 500
          },
          "category": {
            "type": "string",
            "description": "分类路径前缀",
            "minLength": 1,
            "maxLength": 320
          },
          "scope": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "global"
                  }
                },
                "required": [
                  "kind"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "project"
                  },
                  "project_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160,
                    "pattern": "^[\\w.-]+$",
                    "description": "真实项目 ID"
                  }
                },
                "required": [
                  "kind",
                  "project_id"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "strategy"
                  },
                  "project_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160,
                    "pattern": "^[\\w.-]+$",
                    "description": "策略所属项目 ID"
                  },
                  "strategy_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160,
                    "pattern": "^[\\w.-]+$",
                    "description": "真实策略 ID"
                  }
                },
                "required": [
                  "kind",
                  "project_id",
                  "strategy_id"
                ],
                "additionalProperties": false
              }
            ]
          },
          "include_archived": {
            "type": "boolean"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "q": {
            "type": "string",
            "maxLength": 500
          },
          "status": {
            "enum": [
              "hot",
              "warm",
              "archived",
              "expired",
              "conflict"
            ]
          },
          "project_id": {
            "type": "string"
          },
          "strategy_id": {
            "type": "string"
          },
          "include_expired": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object"
      },
      "execution": "immediate",
      "effects": [
        "read:memory"
      ],
      "resultRetention": "summary",
      "usage": {
        "purpose": "检索当前会话有权读取的长期记忆摘要。默认包含归档记忆，可按需召回；过期事实默认不返回。检索与读取不会刷新采用时间，不把记忆当作权限来源。",
        "inputs": "query（或q）为关键词；可按 category/scope/status 筛选；默认含 archived，不含 expired；limit 默认50、最大200。 交易分类为 trading/style、trading/risk-rules、trading/strategy-knowledge；实盘红线读取使用 memory_trading_context，不能把搜索首屏当作全部规则。",
        "outputs": "{items,total}；items 是摘要/状态/版本/source_count，正文和来源用 memory_read(id)。",
        "prerequisites": [
          "有当前会话；插件私有库由宿主激活。"
        ],
        "limitations": [
          "搜索不刷新采用时间；归档可用，expired/conflict 必须重新核实。scope 是资料分类，不授予权限。"
        ]
      },
      "binding": {
        "type": "native",
        "name": "memory_search"
      }
    },
    {
      "id": "memory_read",
      "kind": "function",
      "consumers": [
        "agent",
        "host"
      ],
      "description": "读取正式记忆正文、来源、版本和生命周期。id 来自 memory_search、save 或 accept 的 memory.id，不能使用候选 ID。expired/conflict 不能作为已确认事实。",
      "inputSchema": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "正式记忆 ID；accept 返回 memory.id，顶层 id 仍属候选",
            "minLength": 1,
            "maxLength": 20000
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "description": "可选正文字符偏移。长正文按next_offset续取；不是页号。"
          },
          "length": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4000,
            "description": "可选正文字符数；显式分页默认4000。省略offset与length时仍返回完整正文。"
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object"
      },
      "execution": "immediate",
      "effects": [
        "read:memory"
      ],
      "resultRetention": "summary",
      "usage": {
        "purpose": "读取记忆正文、来源、版本和生命周期。归档可按需读取；expired/conflict 不能作为已确认事实采用。",
        "inputs": "正式记忆 id 来自 memory_search.items、memory_manage action=save 或 action=accept 的 memory.id；accept 顶层 id 仍是候选，不可用于 memory_read。 可选 offset/length 分段读取长正文，length 为1..4000、默认4000。先用 offset:0；之后传回 next_offset。若宿主出现 _tool_output_truncated，这只是预览，须按此方式重读，不当完整规则。",
        "outputs": "完整正文、sources、scope、version、status、review_due、reference_count 等真实记忆记录。 显式分页另含 next_offset（末段为null）、total_content_length、content_complete；content是该段正文，id/version/scope/sources仍保留。拼接时各段 version 必须相同，否则重读最新版本。",
        "prerequisites": [],
        "limitations": [
          "读取不算采用；更新所需 expected_version 来自 version，不从时间或标题推测。"
        ]
      },
      "binding": {
        "type": "native",
        "name": "memory_read"
      }
    },
    {
      "id": "memory_trading_context",
      "kind": "function",
      "consumers": [
        "agent",
        "host"
      ],
      "description": "一次读取个人交易风格、风险红线与策略认知。风险正文跨范围完整返回或明确列出未读 ID，包含冲突和待复核规则；不受启动摘要条数限制。只读，不代表交易授权或已经部署风控。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "default": 10,
            "description": "风格和策略认知各自返回的摘要条数；不截断风险规则条数。"
          },
          "risk_offset": {
            "type": "integer",
            "minimum": 0,
            "default": 0,
            "description": "仅当上一页 next_risk_offset 非 null 时传回；通常省略。"
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "risk_state": {
            "enum": [
              "missing",
              "needs_review",
              "documented"
            ]
          },
          "complete": {
            "type": "boolean"
          },
          "risk_rules": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "unread_risk_rule_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "pending_risk_candidates": {
            "type": "integer",
            "minimum": 0
          },
          "style": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "strategy_knowledge": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "totals": {
            "type": "object",
            "properties": {
              "risk_rules": {
                "type": "integer"
              },
              "style": {
                "type": "integer"
              },
              "strategy_knowledge": {
                "type": "integer"
              }
            },
            "required": [
              "risk_rules",
              "style",
              "strategy_knowledge"
            ]
          },
          "risk_offset": {
            "type": "integer",
            "minimum": 0
          },
          "next_risk_offset": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "risk_state",
          "complete",
          "risk_rules",
          "unread_risk_rule_ids",
          "pending_risk_candidates",
          "style",
          "strategy_knowledge",
          "totals",
          "risk_offset",
          "next_risk_offset"
        ]
      },
      "execution": "immediate",
      "effects": [
        "read:memory"
      ],
      "resultRetention": "summary",
      "usage": {
        "purpose": "为交易相关任务取得三类个人记忆；增加实盘风险、设立或调整规则时读取，风险红线优先于风格和策略观点。",
        "inputs": "{} 即可；可传 limit:1..20，默认10，仅控制另两类摘要。无需猜测账户筛选字段；返回的 scope 和正文明确适用条件。 仅当结果 next_risk_offset 非 null 时，传 risk_offset 续取剩余规则元数据。",
        "outputs": "risk_rules 是未被手工归档的全部风险规则正文、来源、确认记录与版本，跨 global/project/strategy 返回供核对实际后端/账户/市场。style/strategy_knowledge 是各 limit 条带来源摘要，正文用 memory_read(id)，更多按对应 category 用 memory_search；totals 是总数。complete 仅表示风险正文是否齐全；整份结果限制在32000 UTF8字节和1800行内，无法纳入的正文列 unread_risk_rule_ids，用 memory_read({id,offset:0,length:4000}) 及 next_offset 读全。极大量规则的元数据需按 next_risk_offset 继续；分页期间有修订需重新核对版本，不能把某页当完整集合。另两类摘要也可能因预算少于 limit，totals 保留全数。risk_state=missing 表示无正式规则；needs_review 表示冲突、过期、复核到期、未确认或尚有未读；documented 仅表示已登记。pending_risk_candidates 不计入生效规则。",
        "prerequisites": [
          "有当前会话且长期记忆插件可用；工作流须显式授予此能力与 memory_read。"
        ],
        "limitations": [
          "返回不代替适用账户判断，不授予交易权限，不保证规则科学或已在券商落实。缺规则时主 Agent 使用当前账户和合约数据核算方案、取得用户确认；风险状态不完整或冲突时暂停新增风险并说明缺项，不能凭偏好或策略放宽红线。",
          "review_at 是复核提醒，原规则不会自动失效；候选不是现行规则。既有授权内的减仓/平仓不能仅因缺少新规则被阻止；仍需核对实际仓位和执行结果。"
        ]
      },
      "binding": {
        "type": "native",
        "name": "memory_trading_context"
      }
    },
    {
      "id": "memory_propose",
      "kind": "function",
      "consumers": [
        "agent",
        "host"
      ],
      "description": "提交待主 Agent 核验的记忆候选，必须引用真实用户消息或已发布成果。候选不会自动成为长期事实；任务结束后未合并候选销毁。",
      "inputSchema": {
        "type": "object",
        "required": [
          "category",
          "title",
          "summary",
          "content",
          "scope",
          "sources"
        ],
        "properties": {
          "category": {
            "type": "string",
            "description": "分类路径，阅读 manage-memory skill 获取完整分类树",
            "minLength": 1,
            "maxLength": 20000
          },
          "title": {
            "type": "string",
            "description": "稳定的事实或偏好名称",
            "minLength": 1,
            "maxLength": 20000
          },
          "summary": {
            "type": "string",
            "description": "用于检索的简短摘要",
            "minLength": 1,
            "maxLength": 20000
          },
          "content": {
            "type": "string",
            "description": "完整结论、依据与适用条件，不保存原始日志",
            "minLength": 1,
            "maxLength": 20000
          },
          "scope": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "global"
                  }
                },
                "required": [
                  "kind"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "project"
                  },
                  "project_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160,
                    "pattern": "^[\\w.-]+$",
                    "description": "真实项目 ID"
                  }
                },
                "required": [
                  "kind",
                  "project_id"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "strategy"
                  },
                  "project_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160,
                    "pattern": "^[\\w.-]+$",
                    "description": "策略所属项目 ID"
                  },
                  "strategy_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160,
                    "pattern": "^[\\w.-]+$",
                    "description": "真实策略 ID"
                  }
                },
                "required": [
                  "kind",
                  "project_id",
                  "strategy_id"
                ],
                "additionalProperties": false
              }
            ]
          },
          "sources": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "user_message"
                    },
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 20000,
                      "description": "真实用户消息 ID；不能使用委派消息或成果 ID"
                    }
                  },
                  "required": [
                    "type",
                    "id"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "artifact"
                    },
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 20000,
                      "description": "原 ArtifactRef.id"
                    },
                    "revision": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 20000,
                      "description": "原 ArtifactRef.revision 字符串"
                    },
                    "kind": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 20000,
                      "description": "原 ArtifactRef.kind"
                    },
                    "digest": {
                      "type": "string",
                      "pattern": "^sha256:[a-f0-9]{64}$",
                      "description": "原 ArtifactRef.digest"
                    },
                    "schemaVersion": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 20000,
                      "description": "原 ArtifactRef.schemaVersion"
                    }
                  },
                  "required": [
                    "type",
                    "id",
                    "revision",
                    "kind",
                    "digest",
                    "schemaVersion"
                  ],
                  "additionalProperties": false
                }
              ],
              "description": "来源必须有 type。冻结成果使用 {type:\"artifact\",...完整 ArtifactRef}；用户表达使用 {type:\"user_message\",id:\"真实消息ID\"}。不省略 type，不改写来源类别或成果版本。"
            },
            "minItems": 1,
            "maxItems": 20
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 64
            },
            "maxItems": 20
          },
          "evidence": {
            "anyOf": [
              {
                "type": "string",
                "const": "explicit"
              },
              {
                "type": "string",
                "const": "verified"
              },
              {
                "type": "string",
                "const": "inferred"
              },
              {
                "type": "string",
                "const": "conflicted"
              }
            ]
          },
          "pinned": {
            "type": "boolean"
          },
          "value": {
            "anyOf": [
              {
                "type": "string",
                "const": "low"
              },
              {
                "type": "string",
                "const": "normal"
              },
              {
                "type": "string",
                "const": "high"
              }
            ]
          },
          "expires_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "review_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "conflicts_with": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 20
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object"
      },
      "execution": "immediate",
      "effects": [
        "write:memory"
      ],
      "resultRetention": "summary",
      "usage": {
        "purpose": "提交待主 Agent 核验的记忆候选，必须引用真实用户消息或已发布成果。候选不会自动成为长期事实；任务结束后未合并候选销毁。",
        "inputs": "category/title/summary/content/scope/sources 必填；用户偏好用 user/workflow 或 user/communication 与 {kind:\"global\"}。sources 用 {type:\"user_message\",id} 或 {type:\"artifact\",...完整ref}；evidence 区分 explicit/verified/inferred/conflicted。 交易偏好使用 trading/style，策略/指标认知使用 trading/strategy-knowledge，风险草案使用 trading/risk-rules；后者始终是候选，不能自行接受为红线。",
        "outputs": "候选 id/version、所有者、来源、正文及到期信息；候选不能用 memory_read 读取。主 Agent 用 memory_manage action=candidates 查看，用候选原始 id/version 接纳；仍不等于正式长期记忆。",
        "prerequisites": [
          "真实用户消息可从 host#messages 数据源读取；成果来源必须已发布。分类表见 manage-memory。"
        ],
        "limitations": [
          "子 Agent 使用候选；重要结论需主 Agent accept。无效来源应查真实消息/成果，不能引用助手自述或委派消息。",
          "风险候选无论 explicit/verified/inferred，都必须由主 Agent 基于本次用户确认接纳；研究证据不能代替用户同意。"
        ]
      },
      "binding": {
        "type": "native",
        "name": "memory_propose"
      }
    },
    {
      "id": "memory_mark_used",
      "kind": "function",
      "consumers": [
        "agent",
        "host"
      ],
      "description": "仅在记忆实际用于一个已发布成果或明确用户决策后记录采用，附具体原因和持久来源。相同来源重复调用不刷新闲置时间；搜索曝光和读取不算采用。",
      "inputSchema": {
        "type": "object",
        "required": [
          "id",
          "reason",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "已实际采用的记忆 ID",
            "minLength": 1,
            "maxLength": 20000
          },
          "reason": {
            "type": "string",
            "description": "说明它如何影响该成果或决策",
            "minLength": 1,
            "maxLength": 20000
          },
          "source": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "user_message"
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 20000,
                    "description": "真实用户消息 ID；不能使用委派消息或成果 ID"
                  }
                },
                "required": [
                  "type",
                  "id"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "artifact"
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 20000,
                    "description": "原 ArtifactRef.id"
                  },
                  "revision": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 20000,
                    "description": "原 ArtifactRef.revision 字符串"
                  },
                  "kind": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 20000,
                    "description": "原 ArtifactRef.kind"
                  },
                  "digest": {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}$",
                    "description": "原 ArtifactRef.digest"
                  },
                  "schemaVersion": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 20000,
                    "description": "原 ArtifactRef.schemaVersion"
                  }
                },
