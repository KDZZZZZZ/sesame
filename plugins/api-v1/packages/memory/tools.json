                },
                "schemaVersion": {
                  "type": "string",
                  "description": "原 ArtifactRef.schemaVersion",
                  "minLength": 1,
                  "maxLength": 20000
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "type",
                "id"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "const": "artifact"
                },
                "id": {
                  "type": "string",
                  "description": "旧报告或已封存成果 ID；只适用于宿主返回的旧引用",
                  "minLength": 1,
                  "maxLength": 20000
                },
                "revision": {
                  "type": "integer",
