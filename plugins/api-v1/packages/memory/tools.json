[
  {
    "name": "memory_search",
    "label": "memory_search",
    "description": "检索当前会话有权读取的长期记忆摘要。默认包含归档记忆，可按需召回；过期事实默认不返回。检索与读取不会刷新采用时间，不把记忆当作权限来源。",
    "parameters": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "中文或其他语言关键词",
          "minLength": 1,
          "maxLength": 20000
        },
        "category": {
          "type": "string",
          "description": "分类路径前缀",
          "minLength": 1,
          "maxLength": 20000
        },
        "scope": {
          "anyOf": [
            {
              "type": "object",
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "global"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "kind",
                "project_id"
              ],
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "project"
                },
                "project_id": {
                  "type": "string",
                  "description": "真实项目 ID",
                  "minLength": 1,
                  "maxLength": 160,
                  "pattern": "^[\\w.-]+$"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "kind",
                "project_id",
                "strategy_id"
              ],
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "strategy"
                },
                "project_id": {
                  "type": "string",
                  "description": "策略所属项目 ID",
                  "minLength": 1,
                  "maxLength": 160,
                  "pattern": "^[\\w.-]+$"
                },
                "strategy_id": {
                  "type": "string",
                  "description": "真实策略 ID",
                  "minLength": 1,
                  "maxLength": 160,
                  "pattern": "^[\\w.-]+$"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "include_archived": {
          "type": "boolean"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "memory_read",
    "label": "memory_read",
    "description": "读取正式记忆正文、来源、版本和生命周期。id 来自 memory_search、save 或 accept 的 memory.id，不能使用 memory_propose 的候选 ID。候选由主 Agent 用 memory_manage action=candidates 查看；expired/conflict 不能当作已确认事实。",
    "parameters": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "正式记忆 ID；accept 返回 memory.id，顶层 id 仍是候选",
          "minLength": 1,
          "maxLength": 20000
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "memory_propose",
    "label": "memory_propose",
    "description": "提交待主 Agent 核验的候选，来源必须包含 type；冻结成果用 {type:\"artifact\",...完整 ArtifactRef}。返回的 id/version 属于候选，主 Agent 接纳时原样使用；候选不能用 memory_read 读取，不自动成为长期事实，任务结束后未合并候选销毁。",
    "parameters": {
      "type": "object",
      "required": [
        "category",
        "title",
        "summary",
        "content",
        "scope",
        "sources"
      ],
      "properties": {
        "category": {
          "type": "string",
          "description": "分类路径，阅读 manage-memory skill 获取完整分类树",
          "minLength": 1,
          "maxLength": 20000
        },
        "title": {
          "type": "string",
          "description": "稳定的事实或偏好名称",
          "minLength": 1,
          "maxLength": 20000
        },
        "summary": {
          "type": "string",
          "description": "用于检索的简短摘要",
          "minLength": 1,
          "maxLength": 20000
        },
        "content": {
          "type": "string",
          "description": "完整结论、依据与适用条件，不保存原始日志",
          "minLength": 1,
          "maxLength": 20000
        },
        "scope": {
          "anyOf": [
            {
              "type": "object",
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "global"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "kind",
                "project_id"
              ],
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "project"
                },
                "project_id": {
                  "type": "string",
                  "description": "真实项目 ID",
                  "minLength": 1,
                  "maxLength": 160,
                  "pattern": "^[\\w.-]+$"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "kind",
                "project_id",
                "strategy_id"
              ],
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "strategy"
                },
                "project_id": {
                  "type": "string",
                  "description": "策略所属项目 ID",
                  "minLength": 1,
                  "maxLength": 160,
                  "pattern": "^[\\w.-]+$"
                },
                "strategy_id": {
                  "type": "string",
                  "description": "真实策略 ID",
                  "minLength": 1,
                  "maxLength": 160,
                  "pattern": "^[\\w.-]+$"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "required": [
                  "type",
                  "id"
                ],
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "user_message"
                  },
                  "id": {
                    "type": "string",
                    "description": "真实用户消息 ID；不能使用委派消息或成果 ID",
                    "minLength": 1,
                    "maxLength": 20000
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "type",
                  "id",
                  "revision",
                  "kind",
                  "digest",
                  "schemaVersion"
                ],
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "artifact"
                  },
                  "id": {
                    "type": "string",
                    "description": "原 ArtifactRef.id",
                    "minLength": 1,
                    "maxLength": 20000
                  },
                  "revision": {
                    "type": "string",
                    "description": "原 ArtifactRef.revision 字符串，不转成整数",
                    "minLength": 1,
                    "maxLength": 20000
                  },
                  "kind": {
                    "type": "string",
                    "description": "原 ArtifactRef.kind",
                    "minLength": 1,
                    "maxLength": 20000
                  },
                  "digest": {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}$",
                    "description": "原 ArtifactRef.digest"
                  },
                  "schemaVersion": {
                    "type": "string",
                    "description": "原 ArtifactRef.schemaVersion",
                    "minLength": 1,
                    "maxLength": 20000
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "type",
                  "id"
                ],
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "artifact"
                  },
                  "id": {
                    "type": "string",
                    "description": "旧报告或已封存成果 ID；只适用于宿主返回的旧引用",
                    "minLength": 1,
                    "maxLength": 20000
                  },
                  "revision": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "kind": {
                    "type": "string",
                    "description": "旧成果种类",
                    "minLength": 1,
                    "maxLength": 20000
                  }
                },
                "additionalProperties": false
              }
            ],
            "description": "来源必须有 type。冻结成果使用 {type:\"artifact\",...完整 ArtifactRef}；用户表达使用 {type:\"user_message\",id:\"真实消息ID\"}。不能只复制 ref 而省略 type，也不能改写来源类别。"
          },
          "minItems": 1,
          "maxItems": 20
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 64
          },
          "maxItems": 20
        },
        "evidence": {
          "anyOf": [
            {
              "type": "string",
              "const": "explicit"
            },
            {
              "type": "string",
              "const": "verified"
            },
            {
              "type": "string",
              "const": "inferred"
            },
            {
              "type": "string",
              "const": "conflicted"
            }
          ]
        },
        "pinned": {
          "type": "boolean"
        },
        "value": {
          "anyOf": [
            {
              "type": "string",
              "const": "low"
            },
            {
              "type": "string",
              "const": "normal"
            },
            {
              "type": "string",
              "const": "high"
            }
          ]
        },
        "expires_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "review_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "conflicts_with": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 20
        }
      },
      "additionalProperties": false
    }
  },
  {
