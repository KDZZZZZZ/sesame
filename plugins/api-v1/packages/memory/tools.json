  {
    "name": "memory_manage",
    "label": "memory_manage",
    "description": "主 Agent 管理记忆：save 创建或修订；candidates 返回候选正文/id/version；accept/reject 使用候选 id/version，accept 的正式记忆在 memory 字段，顶层 id 仍属候选。archive/restore/forget 使用正式记忆 ID。version_conflict 后重读对应对象并核验，不能跳过 expected_version；过期候选从最终成果重新核验提取。",
    "parameters": {
      "type": "object",
      "required": [
        "action"
      ],
      "properties": {
        "action": {
          "anyOf": [
            {
              "type": "string",
              "const": "save"
            },
            {
              "type": "string",
              "const": "candidates"
            },
            {
              "type": "string",
              "const": "accept"
            },
            {
              "type": "string",
              "const": "reject"
            },
            {
              "type": "string",
              "const": "archive"
            },
            {
              "type": "string",
              "const": "restore"
            },
            {
              "type": "string",
              "const": "forget"
            },
            {
              "type": "string",
              "const": "stats"
            }
          ]
        },
        "id": {
          "type": "string",
          "description": "accept/reject 使用候选 ID；其余写操作使用正式记忆 ID",
          "minLength": 1,
          "maxLength": 20000
        },
        "expected_version": {
          "type": "integer",
          "minimum": 1,
          "description": "对应对象最新 version：候选来自 candidates，正式记忆来自 memory_read；不是成果 revision"
        },
