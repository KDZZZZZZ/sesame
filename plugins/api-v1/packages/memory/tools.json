                },
                "kind": {
                  "type": "string",
                  "description": "旧成果种类",
                  "minLength": 1,
                  "maxLength": 20000
                }
              },
              "additionalProperties": false
            }
          ],
          "description": "来源必须有 type。冻结成果使用 {type:\"artifact\",...完整 ArtifactRef}；用户表达使用 {type:\"user_message\",id:\"真实消息ID\"}。不能只复制 ref 而省略 type，也不能改写来源类别。"
        }
