    {
      "id": "ultra_before_turn",
      "kind": "function",
      "consumers": [
        "host"
      ],
      "execution": "immediate",
      "description": "Keep trusted human-input authority and explicit Ultra reopen intent without modifying visible message content.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "messageId": {
            "type": "string"
          },
