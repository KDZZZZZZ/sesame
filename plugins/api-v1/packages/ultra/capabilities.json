{
  "schemaVersion": 1,
  "apiVersion": "2",
  "capabilities": [
    {
      "id": "ultra_start",
      "kind": "function",
      "consumers": [
        "agent",
        "host"
      ],
      "description": "开始持续协作目标并创建真实规划工作流；同会话已有任务返回现有状态，不重复开工。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "objective": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16000
          },
          "context": {
            "type": "string",
            "maxLength": 60000
          },
          "mode": {
            "enum": [
              "auto",
              "research",
              "monitor",
              "trade"
            ]
          },
          "max_parallel": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16
          },
          "plugins": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "maxItems": 64,
            "uniqueItems": true
          },
          "success_criteria": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "maxItems": 32,
            "uniqueItems": true
          }
        },
        "required": [
          "objective"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": true
      },
      "execution": "immediate",
      "effects": [
        "state.write",
        "start:workflow"
      ],
      "usage": {
        "purpose": "开始持续协作目标并创建真实规划工作流；同会话已有任务返回现有状态，不重复开工。",
        "inputs": "Use the current user's accepted objective and scope. id may be omitted by owner controls.",
        "outputs": "Durable goal status and actual Run references. Run acceptance is not task completion; inspect real outputs. Completed native cycles wake the main Agent through the host's existing notification queue.",
        "prerequisites": [
          "Configured model for planning; selected capabilities remain enabled and locally authorized."
        ],
        "limitations": [
          "Only the owning main conversation controls the goal. Ultra adds no trading authorization and does not replay unknown side effects.",
          "No fixed number of rounds. A user stop ends continuation; missing input and host restart retain explicit recovery state."
        ]
      },
      "binding": {
        "type": "native",
        "name": "ultra_start"
      }
    },
    {
      "id": "ultra_status",
      "kind": "function",
      "consumers": [
        "agent",
        "host"
      ],
      "description": "查看当前会话 Ultra 的目标、分支、真实 Run、等待和完成证据，读取不会启动研究。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "branch_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": true
      },
      "execution": "immediate",
      "effects": [
        "state.read",
        "state.write",
        "read"
      ],
      "usage": {
        "purpose": "查看当前会话 Ultra 的目标、分支、真实 Run、等待和完成证据，读取不会启动研究。",
        "inputs": "Use the current user's accepted objective and scope. id may be omitted by owner controls.",
        "outputs": "Durable goal status and real Run references, plus enabled, continuation (active/draining/closed), active_work, accepted_work and queued_work. Reading never starts research or advances user authority. guidance contains the current mode instructions for model-only context assembly; never append it to visible user messages.",
        "prerequisites": [
          "Configured model for planning; selected capabilities remain enabled and locally authorized."
        ],
        "limitations": [
          "Only the owning main conversation controls the goal. Ultra adds no trading authorization and does not replay unknown side effects.",
          "No fixed number of rounds. A user stop ends continuation; missing input and host restart retain explicit recovery state."
        ]
      },
      "binding": {
        "type": "native",
        "name": "ultra_status"
      }
    },
    {
      "id": "ultra_dispatch",
      "kind": "function",
      "consumers": [
        "agent",
        "host"
      ],
      "description": "从主会话并行派发精确的研究/工作流能力；保存稳定分支键和实际 Run。超出当前并发容量的工作排队；使用空 branches 填充空余槽位。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "branches": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 96
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "capability": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "input": {
                  "type": "object",
                  "additionalProperties": true
                },
                "task": {
                  "type": "object",
                  "properties": {
                    "title": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 120
                    },
                    "output": {
                      "oneOf": [
                        {
                          "type": "object",
                          "properties": {
                            "type": {
                              "const": "none"
                            }
                          },
                          "required": [
                            "type"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "type": {
                              "const": "report"
                            },
                            "space": {
                              "enum": [
                                "research",
                                "strategy"
                              ]
                            },
                            "path": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 512
                            }
                          },
                          "required": [
                            "type",
                            "space",
                            "path"
                          ],
                          "additionalProperties": false
                        }
                      ]
                    }
                  },
                  "required": [],
                  "additionalProperties": false
                },
                "exclusive": {
                  "type": "boolean"
                },
                "stop": {
                  "type": "object",
                  "properties": {
                    "capability": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "input": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  },
                  "required": [
                    "capability",
                    "input"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "key",
                "title",
                "capability",
                "input"
              ],
              "additionalProperties": false
            },
            "maxItems": 64
          },
          "summary": {
            "type": "string",
            "maxLength": 4000
          }
        },
        "required": [
          "branches"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": true
      },
      "execution": "immediate",
      "effects": [
        "state.write",
        "declared-calls",
        "start:workflow"
      ],
      "usage": {
        "purpose": "从主会话并行派发精确的研究/工作流能力；保存稳定分支键和实际 Run。超出当前并发容量的工作排队；使用空 branches 填充空余槽位。",
        "inputs": "Each branch has stable key/title/capability/input and optional task report binding. Discover exact schemas first. Use existing workflows and publish actual reports. Never place credentials in inputs. No generic recursive Agent grants; assign exact business tools. A persistent scheduler/subscription needs its exact stop action.",
        "outputs": "Durable goal status and actual Run references. Run acceptance is not task completion; inspect real outputs. Completed native cycles wake the main Agent through the host's existing notification queue.",
        "prerequisites": [
          "Configured model for planning; selected capabilities remain enabled and locally authorized."
        ],
        "limitations": [
          "Only the owning main conversation controls the goal. Ultra adds no trading authorization and does not replay unknown side effects.",
          "No fixed number of rounds. A user stop ends continuation; missing input and host restart retain explicit recovery state."
        ]
      },
      "binding": {
        "type": "native",
        "name": "ultra_dispatch"
      }
    },
