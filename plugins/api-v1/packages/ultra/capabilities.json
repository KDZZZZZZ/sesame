      "execution": "immediate",
      "effects": [
        "state.read",
        "state.write",
        "read"
      ],
      "usage": {
        "purpose": "关闭 Ultra 主动拓展，保留已经开始的研究、Run 和订阅自然收尾；不取消、不恢复已有任务，也不表示目标已完成。",
        "inputs": "Owning main conversation; optional id and reason. UI close and /ultra off use this operation.",
        "outputs": "Persistent enabled=false; continuation is draining while finite accepted work remains, then closed. Existing work and its completion notices are retained.",
        "prerequisites": [
          "Existing owning main conversation."
        ],
        "limitations": [
          "Does not cancel accepted Runs or call domain stop actions. Unstarted queued work is withdrawn. New expansion requires an explicit new user request to start or resume Ultra."
        ]
      },
      "binding": {
        "type": "native",
        "name": "ultra_close"
      }
    },
