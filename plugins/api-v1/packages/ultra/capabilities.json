            "items": {
              "type": "object",
              "additionalProperties": true
            }
          }
        },
        "required": [
          "parts"
        ],
        "additionalProperties": false
      },
      "effects": [
        "state.write"
      ],
      "usage": {
        "purpose": "Keep a durable human-input boundary and explicit Ultra reopening intent.",
        "inputs": "Trusted host lifecycle metadata and message parts. Only real human input advances authority; explicit Ultra restart intent is retained as a boolean, never message text.",
        "outputs": "Unchanged message parts; visible user content never receives internal mode instructions.",
        "prerequisites": [
          "Trusted beforeAgentTurn lifecycle."
        ],
        "limitations": [
          "Automatic/delegated input never advances user authority. Closed mode does not disable normal collaboration capabilities."
        ]
      },
      "binding": {
        "type": "native",
        "name": "ultra_before_turn"
      }
    },
