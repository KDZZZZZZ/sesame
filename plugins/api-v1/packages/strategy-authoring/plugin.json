{
  "id": "sesame/strategy-authoring",
  "apiVersion": "1",
  "version": "1.2.0",
  "title": "SVL 策略创作",
  "description": "编写、可视化与重放 SVL 策略；提供指标函数、动态品种池、组合分配、风险与执行账本，以及隔离的 Agent 判断和冻结时间线。原生回测与交易由目标插件提供。",
  "author": {
    "name": "Sesame"
  },
  "license": "MIT",
  "default_state": "mounted",
  "agent_scope": "all",
  "entry": "index.js",
  "tool_definitions": "tools.json",
  "tool_names": [
    "strategy_validate",
    "strategy_publish",
    "strategy_graph",
    "strategy_replay",
    "strategy_pipeline",
    "strategy_workflow",
    "strategy_decision",
    "strategy_functions"
  ],
  "prompts": [
    "prompt.md"
  ],
  "skills": [
    "skills"
  ],
  "resources": [
    "skills/strategy-authoring/references/language.md",
    "skills/strategy-authoring/references/architecture.md",
    "examples/close-threshold.svl.json",
    "examples/close-threshold.replay.json",
    "examples/crossover.svl.json",
    "examples/crossover.replay.json",
    "skills/strategy-authoring/references/pipeline.md",
    "skills/strategy-authoring/references/agent-inputs.md",
    "examples/function-threshold.svl.json",
    "examples/function-threshold.replay.json",
    "examples/pipeline-fixture.js",
    "skills/strategy-authoring/references/methods.md",
    "skills/strategy-authoring/references/execution.md",
    "skills/strategy-authoring/references/quant-functions.md",
    "examples/method-workflow.js"
  ],
  "provides": {
    "sesame.strategy": "1"
  },
  "engines": {
    "sesame": ">=0.2.2"
  }
}
