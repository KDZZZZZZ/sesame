{
  "schemaVersion": 1,
  "apiVersion": "2",
  "configSchema": {
    "type": "object",
    "properties": {},
    "required": [],
    "additionalProperties": false
  },
  "capabilities": [
    {
      "id": "agent_list",
      "kind": "function",
      "consumers": [
        "agent",
        "host"
      ],
      "description": "分页读取宿主管理的 Agent、进程和插件 Run 状态。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "cursor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "description": "上一页返回的游标"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object"
      },
      "execution": "immediate",
      "effects": [],
      "usage": {
        "purpose": "分页读取宿主管理的 Agent、进程和插件 Run 状态。",
        "inputs": "cursor 使用上一页 nextCursor，limit 默认 50、范围 1–200。空输入读取第一页。",
        "outputs": "{items,nextCursor?}；items 是宿主 Agent、进程、插件 Run 的概要和真实状态。",
        "prerequisites": [],
        "limitations": [
          "列表不启动、等待或停止任务；详细结果由 agent_inspect(runId) 读取。"
        ]
      },
      "binding": {
        "type": "native",
        "name": "agent_list"
      }
    },
    {
      "id": "agent_delegate",
      "kind": "function",
      "consumers": [
        "agent",
        "host"
      ],
      "description": "启动真实 Agent Run，显式给出目标、指令、允许调用的能力和执行预算。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "description": "任务标题"
          },
          "instructions": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128000,
            "description": "任务指令"
          },
          "objective": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16000,
            "description": "验收目标"
          },
          "input": {
            "type": "object"
          },
          "allowedCalls": {
            "type": "array",
            "maxItems": 256,
            "items": {
              "type": "object",
              "properties": {
                "pluginId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096,
                  "description": "插件ID或host"
                },
                "capabilityId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096,
                  "description": "声明的本地能力ID"
                }
              },
              "required": [
                "pluginId",
                "capabilityId"
              ],
              "additionalProperties": false
            }
          },
          "budget": {
            "type": "object",
            "properties": {
              "maxTurns": {
                "type": "integer",
                "minimum": 1,
                "maximum": 64
              },
              "maxToolCalls": {
                "type": "integer",
                "minimum": 0,
                "maximum": 256
              },
              "timeoutMs": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1800000
              }
            },
            "required": [
              "maxTurns",
              "maxToolCalls",
              "timeoutMs"
            ],
            "additionalProperties": false
          },
          "model": {
            "type": "object",
            "properties": {
              "provider": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "description": "配置中的provider"
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "description": "配置中的model"
              },
              "configurationDigest": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "description": "配置摘要"
              }
            },
            "required": [
              "provider",
              "id",
              "configurationDigest"
            ],
            "additionalProperties": false
          },
          "operationId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "稳定操作ID"
          },
          "output": {
            "anyOf": [
              {
                "type": "object",
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "const": "none"
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": [
                  "type",
                  "space",
                  "path"
                ],
                "properties": {
                  "type": {
                    "const": "report"
                  },
                  "space": {
                    "enum": [
                      "research",
                      "strategy"
                    ]
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  }
                },
                "additionalProperties": false
              }
            ]
          },
          "task": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "role": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "stage": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "iteration": {
                "type": "integer",
                "minimum": 0
              },
              "output": {
                "anyOf": [
                  {
                    "type": "object",
                    "required": [
                      "type"
                    ],
                    "properties": {
                      "type": {
                        "const": "none"
                      }
                    },
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "required": [
                      "type",
                      "space",
                      "path"
                    ],
                    "properties": {
                      "type": {
                        "const": "report"
                      },
                      "space": {
                        "enum": [
                          "research",
                          "strategy"
                        ]
                      },
                      "path": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 512
                      }
                    },
                    "additionalProperties": false
                  }
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "title",
          "instructions",
          "objective",
          "input",
          "allowedCalls",
          "budget"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object"
      },
      "execution": "immediate",
      "effects": [
        "agent.run"
      ],
      "usage": {
        "purpose": "启动真实 Agent Run，显式给出目标、指令、允许调用的能力和执行预算。",
        "inputs": "title/objective/instructions/input 明确子任务目标与验收；allowedCalls=[{pluginId,capabilityId}] 为精确白名单，可为空；budget={maxTurns,maxToolCalls,timeoutMs} 三项必填。model 可省略复用配置；显式指定需 {provider,id,configurationDigest}。operationId 对同一请求保持稳定。output={type:\"report\",space:\"research\",path:\"review.html\"} 可指定报告，否则省略。",
        "outputs": "{type:\"run\",run,receipt} 是已受理的统一 RunRef；用 run.id 检查最终状态、output 与报告，受理不等于完成。",
        "prerequisites": [
          "配置可用模型；允许能力须已声明且可用，能力 ID 可从 plugin_read(manifest) 或 host.capabilities.list 取得。"
        ],
        "limitations": [
          "指令给出已知输入、可用能力与可量化目标，不把本来已知的依赖留给子任务猜测。等待用 agent_inspect；超时只结束等待，不取消任务。"
        ]
      },
      "binding": {
        "type": "native",
        "name": "agent_delegate"
      }
    },
    {
      "id": "agent_inspect",
      "kind": "function",
      "consumers": [
        "agent",
        "host"
      ],
      "description": "读取 Run 与可选事件页，等待宿主状态变化或完成。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "runId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "description": "Run ID"
          },
          "wait": {
            "enum": [
              "changed",
              "settled"
            ]
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30000
          },
          "includeHistory": {
            "type": "boolean"
          },
          "cursor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "description": "上一页返回的游标"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          }
        },
        "required": [
          "runId"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object"
      },
      "execution": "immediate",
      "effects": [],
      "usage": {
        "purpose": "读取 Run 与可选事件页，等待宿主状态变化或完成。",
        "inputs": "runId 来自 agent_delegate.run.id 或 agent_list.items；wait 省略立即读取，settled 等终态、changed 等下一次变化；timeoutMs 是本次等待上限。includeHistory=true 可取消息、调用、事件、输出与资源页。",
        "outputs": "{run,history?,waitReason?}；run.status/output/error 是实际结果，waitReason=timeout 表示仍可能运行。",
        "prerequisites": [],
        "limitations": [
          "不启动 Agent；等待由宿主事件唤醒，无需用 shell sleep 轮询。失败先读 error/已完成输出，修正具体依赖再发新任务。"
        ]
      },
      "binding": {
        "type": "native",
        "name": "agent_inspect"
      }
    },
    {
      "id": "agent_stop",
      "kind": "function",
      "consumers": [
        "agent",
        "host"
      ],
      "description": "取消 Run 并返回宿主状态与回执。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "runId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "description": "Run ID"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "description": "停止原因"
          }
        },
        "required": [
          "runId"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object"
      },
      "execution": "immediate",
      "effects": [
        "run.cancel"
      ],
      "usage": {
        "purpose": "取消 Run 并返回宿主状态与回执。",
        "inputs": "runId 指向要取消的宿主 Run；reason 记录取消原因。",
        "outputs": "取消请求的回执和最新 Run；最终状态由 agent_inspect 确认。",
        "prerequisites": [],
        "limitations": [
          "取消进程或 Agent 不撤回已产生的文件、报告或外部业务操作；结果不明时读取 Run 和业务状态。"
        ]
      },
      "binding": {
        "type": "native",
        "name": "agent_stop"
      }
    }
  ],
