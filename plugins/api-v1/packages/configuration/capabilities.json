{
  "schemaVersion": 1,
  "apiVersion": "2",
  "configSchema": {
    "type": "object",
    "properties": {},
    "required": [],
    "additionalProperties": false
  },
  "capabilities": [
    {
      "id": "configuration_read",
      "kind": "function",
      "consumers": [
        "agent",
        "host"
      ],
      "description": "读取模型、认证状态、偏好、应用保存的环境配置和已安装插件。环境配置只返回名称、configured 和 source，不返回密钥或密码。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "section": {
            "anyOf": [
              {
                "type": "string",
                "const": "all"
              },
              {
                "type": "string",
                "const": "model"
              },
              {
                "type": "string",
                "const": "preferences"
              },
              {
                "type": "string",
                "const": "environment"
              }
            ]
          },
          "provider": {
            "type": "string",
            "description": "供应商 ID",
            "minLength": 1,
            "maxLength": 20000
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": true
      },
      "execution": "immediate",
      "effects": [],
      "usage": {
        "purpose": "读取模型、认证状态、偏好、应用保存的环境配置和已安装插件。环境配置只返回名称、configured 和 source，不返回密钥或密码。",
        "inputs": "section 默认 all；model 返回模型与认证状态，preferences 返回偏好与版本，environment 返回环境配置名称、configured 和 source；provider 可筛选模型供应商。",
        "outputs": "公开设置和 recent_changes 状态回执；environment 只描述配置是否存在及来源，所有 section 均不返回秘密值。",
        "prerequisites": [
          "主 Agent 会话。"
        ],
        "limitations": [
          "只读；queued/running/unknown 的变更尚不能算已生效。"
        ]
      },
      "binding": {
        "type": "native",
        "name": "configuration_read"
      }
    },
    {
      "id": "configuration_update",
      "kind": "function",
      "consumers": [
        "agent",
        "host"
      ],
      "description": "按用户要求直接保存模型 API Key、兼容接口、插件环境凭据或应用偏好；无需导入、手工设置环境变量或打开设置窗口。target=environment 将 changes 的环境变量值私有持久保存并立即生效，null 删除；target=model 在当前回复结束后应用。回执不含秘密。",
      "inputSchema": {
        "type": "object",
        "required": [
          "command_id",
          "target",
          "changes"
        ],
        "properties": {
          "command_id": {
            "type": "string",
            "minLength": 16,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "target": {
            "anyOf": [
              {
                "type": "string",
                "const": "model"
              },
              {
                "type": "string",
                "const": "preferences"
              },
              {
                "type": "string",
                "const": "environment"
              }
            ]
          },
          "expected_version": {
            "type": "integer",
            "minimum": 1
          },
          "changes": {
            "anyOf": [
              {
                "type": "object",
                "required": [
                  "provider",
                  "model"
                ],
                "properties": {
                  "provider": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "model": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "thinking": {
                    "anyOf": [
                      {
                        "type": "string",
                        "const": "off"
                      },
                      {
                        "type": "string",
                        "const": "minimal"
                      },
                      {
                        "type": "string",
                        "const": "low"
                      },
                      {
                        "type": "string",
                        "const": "medium"
                      },
                      {
                        "type": "string",
                        "const": "high"
                      },
                      {
                        "type": "string",
                        "const": "xhigh"
                      },
                      {
                        "type": "string",
                        "const": "max"
                      }
                    ]
                  },
                  "api_key": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 8192,
                    "writeOnly": true,
                    "description": "用户提供的 API Key 原文，宿主私有保存；省略时复用已有认证。",
                    "pattern": "^[^\\r\\n\\u0000]+$"
                  },
                  "base_url": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048,
                    "description": "仅自定义供应商：HTTPS 接口地址，本机服务可用 HTTP。"
                  },
                  "api": {
                    "anyOf": [
                      {
                        "type": "string",
                        "const": "openai-completions"
                      },
                      {
                        "type": "string",
                        "const": "openai-responses"
                      },
                      {
                        "type": "string",
                        "const": "anthropic-messages"
                      },
                      {
                        "type": "string",
                        "const": "google-generative-ai"
                      }
                    ]
                  },
                  "context_window": {
                    "type": "integer",
                    "minimum": 1024,
                    "maximum": 10000000
                  },
                  "max_tokens": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "reasoning": {
                    "type": "boolean"
                  }
                },
                "additionalProperties": false,
                "minProperties": 1
              },
              {
                "type": "object",
                "properties": {
                  "locale": {
                    "anyOf": [
                      {
                        "type": "string",
                        "const": "zh-CN"
                      },
                      {
                        "type": "string",
                        "const": "en"
                      }
                    ]
                  },
                  "account_view": {
                    "type": "object",
                    "properties": {
                      "source": {
                        "anyOf": [
                          {
                            "type": "object",
                            "required": [
                              "provider"
                            ],
                            "properties": {
                              "provider": {
                                "type": "object",
                                "required": [
                                  "pluginId",
                                  "providerId"
                                ],
                                "properties": {
                                  "pluginId": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 512,
                                    "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                                  },
                                  "providerId": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 512,
                                    "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                                  }
                                },
                                "additionalProperties": false
                              },
                              "connection": {
                                "type": "object",
                                "required": [
                                  "id",
                                  "revision"
                                ],
                                "properties": {
                                  "id": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 512,
                                    "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                                  },
                                  "revision": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 512,
                                    "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                                  }
                                },
                                "additionalProperties": false
                              },
                              "accountId": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 512,
                                "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                              },
                              "accountConnectionId": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 512,
                                "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                              }
                            },
                            "additionalProperties": false
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "sources": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "required": [
                            "provider"
                          ],
                          "properties": {
                            "provider": {
                              "type": "object",
                              "required": [
                                "pluginId",
                                "providerId"
                              ],
                              "properties": {
                                "pluginId": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 512,
                                  "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                                },
                                "providerId": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 512,
                                  "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                                }
                              },
                              "additionalProperties": false
                            },
                            "connection": {
                              "type": "object",
                              "required": [
                                "id",
                                "revision"
                              ],
                              "properties": {
                                "id": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 512,
                                  "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                                },
                                "revision": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 512,
                                  "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                                }
                              },
                              "additionalProperties": false
                            },
                            "accountId": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 512,
                              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                            },
                            "accountConnectionId": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 512,
                              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                            }
                          },
                          "additionalProperties": false
                        },
                        "maxItems": 32
                      },
                      "selected": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "required": [
                            "provider",
                            "accountId"
                          ],
                          "properties": {
                            "provider": {
                              "type": "object",
                              "required": [
                                "pluginId",
                                "providerId"
                              ],
                              "properties": {
                                "pluginId": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 512,
                                  "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                                },
                                "providerId": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 512,
                                  "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                                }
                              },
                              "additionalProperties": false
                            },
                            "connection": {
                              "type": "object",
                              "required": [
                                "id",
                                "revision"
                              ],
                              "properties": {
                                "id": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 512,
                                  "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                                },
                                "revision": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 512,
                                  "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                                }
                              },
                              "additionalProperties": false
                            },
                            "accountId": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 512,
                              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                            },
                            "accountConnectionId": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 512,
                              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                            }
                          },
                          "additionalProperties": false
                        },
                        "maxItems": 32,
                        "description": "当前勾选账户；沿用读取结果的 provider、精确 connection、accountId 与 accountConnectionId。空数组取消全部勾选。"
                      }
                    },
                    "additionalProperties": false,
                    "minProperties": 1
                  }
                },
                "additionalProperties": false,
                "minProperties": 1
              },
              {
                "type": "object",
                "minProperties": 1,
                "propertyNames": {
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"
                },
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 8192,
                      "pattern": "^[^\\r\\n\\u0000]+$",
                      "writeOnly": true
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "maxProperties": 128
              }
            ]
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": true
      },
      "execution": "immediate",
      "effects": [
        "application-configuration"
      ],
      "usage": {
        "purpose": "按用户要求直接保存模型 API Key、兼容接口、插件环境凭据或应用偏好；无需导入、手工设置环境变量或打开设置窗口。target=environment 将 changes 的环境变量值私有持久保存并立即生效，null 删除；target=model 在当前回复结束后应用。回执不含秘密。",
        "inputs": "target=environment：changes={FMP_API_KEY:<用户提供的值>,FRED_API_KEY:<用户提供的值>}，值为单行非空字符串或 null 删除，不传 expected_version。target=model：changes={provider,model,thinking?,api_key?,base_url?,api?,context_window?,max_tokens?,reasoning?}，不传 expected_version；自定义接口使用新的 provider ID，base_url 与 api 配套。target=preferences：changes 为偏好补丁，expected_version 来自 preferences.version。command_id 为本次修改的稳定 ID。",
        "outputs": "脱敏变更回执 {id,target,status,changes,result?,error?}；environment/preferences 的 applied 表示已持久化生效，model 的 queued 表示将在当前回复结束后处理。秘密不会出现在回执中。",
        "prerequisites": [
          "主 Agent；使用用户提供的凭据或已保存认证，只有缺少必要信息时才询问用户。"
        ],
        "limitations": [
          "保存配置不证明远端认证、套餐或网络可用，使用对应能力的实际结果确认。",
          "version_conflict 时重读并以新 command_id 提交修订补丁；model 返回 queued 后不要本轮反复轮询或重复提交，下一轮可读取 recent_changes。",
          "自定义模型使用已知接口协议；只有供应商本身要求 OAuth 交互时才需要登录界面。"
        ]
      },
      "binding": {
        "type": "native",
        "name": "configuration_update"
      }
    },
    {
      "id": "configuration_open",
      "kind": "function",
      "consumers": [
        "agent",
        "host"
      ],
      "description": "按用户要求打开设置，或完成供应商要求的交互式 OAuth 登录。API Key、模型接口和插件环境凭据可由 configuration_update 直接保存，不需要打开设置。",
      "inputSchema": {
        "type": "object",
        "required": [
          "dialog"
        ],
        "properties": {
          "dialog": {
            "type": "string",
            "const": "settings"
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": true
      },
      "execution": "immediate",
      "effects": [
        "presentation"
      ],
      "usage": {
        "purpose": "按用户要求打开设置，或完成供应商要求的交互式 OAuth 登录。API Key、模型接口和插件环境凭据可由 configuration_update 直接保存，不需要打开设置。",
        "inputs": "dialog=\"settings\"；打开 Sesame 设置页，不接收凭据或平台连接参数。",
        "outputs": "宿主 views.open 的界面打开回执；不表示用户完成认证或配置。",
        "prerequisites": [
          "主 Agent 会话。"
        ],
        "limitations": [
          "打开设置不证明已认证；API Key 配置直接使用 configuration_update，平台连接使用对应插件配置能力。"
        ]
      },
      "binding": {
        "type": "native",
        "name": "configuration_open"
      }
    }
  ],
  "sources": [],
  "views": [],
  "services": [],
  "knowledge": [
    {
      "id": "documentation-0",
      "path": "prompt.md",
      "description": "Documentation: prompt.md",
      "kind": "prompt"
    },
    {
      "id": "documentation-1",
      "path": "skills/configure-application/SKILL.md",
      "description": "Documentation: skills\\configure-application\\SKILL.md",
      "kind": "skill"
    },
    {
      "id": "configuration-guide",
      "path": "README.md",
      "description": "Agent 直接配置模型、插件凭据和偏好的参数与生效方式。",
      "kind": "reference"
    }
  ],
  "hooks": [],
  "stateCollections": [],
  "artifactSchemas": []
}
