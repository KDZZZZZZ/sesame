{
  "schemaVersion": 1,
  "apiVersion": "2",
  "configSchema": {
    "type": "object",
    "properties": {},
    "required": [],
    "additionalProperties": false
  },
  "capabilities": [
    {
      "id": "configuration_read",
      "kind": "function",
      "consumers": [
        "agent",
        "host"
      ],
      "description": "读取模型、认证状态、偏好和已安装插件。不会返回秘密或启动程序。连接设置由对应提供方插件管理。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "section": {
            "anyOf": [
              {
                "type": "string",
                "const": "all"
              },
              {
                "type": "string",
                "const": "model"
              },
              {
                "type": "string",
                "const": "preferences"
              }
            ]
          },
          "provider": {
            "type": "string",
            "description": "供应商 ID",
            "minLength": 1,
            "maxLength": 20000
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": true
      },
      "execution": "immediate",
      "effects": [],
      "usage": {
        "purpose": "读取模型、认证状态、偏好和已安装插件。不会返回秘密或启动程序。连接设置由对应提供方插件管理。",
        "inputs": "section 默认 all；model 返回模型/认证可用性，preferences 返回偏好；provider 可筛选供应商并展开其模型。例：{section:\"model\",provider:\"openai\"}。",
        "outputs": "recent_changes 加所选的 model/providers/available_models/preferences；all 另含 network/plugins。preferences.version 是偏好修改前提，认证只有状态。",
        "prerequisites": [
          "主 Agent 会话。"
        ],
        "limitations": [
          "只读；queued/running/unknown 的变更尚不能算已生效。"
        ]
      },
      "binding": {
        "type": "native",
        "name": "configuration_read"
      }
    },
    {
      "id": "configuration_update",
      "kind": "function",
      "consumers": [
        "agent",
        "host"
      ],
      "description": "按用户要求修改回复语言、账户视图的精确连接/账户选择或已认证模型。偏好修改使用 configuration_read 返回的 preferences.version 作为 expected_version；不传凭据。模型切换不传 expected_version，queued 后等待本轮结束再确认。",
      "inputSchema": {
        "type": "object",
        "required": [
          "command_id",
          "target",
          "changes"
        ],
        "properties": {
          "command_id": {
            "type": "string",
            "minLength": 16,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "target": {
            "anyOf": [
              {
                "type": "string",
                "const": "model"
              },
              {
                "type": "string",
                "const": "preferences"
              }
            ]
          },
          "expected_version": {
            "type": "integer",
            "minimum": 1
          },
          "changes": {
            "anyOf": [
              {
                "type": "object",
                "required": [
                  "provider",
                  "model"
                ],
                "properties": {
                  "provider": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "model": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "thinking": {
                    "anyOf": [
                      {
                        "type": "string",
                        "const": "off"
                      },
                      {
                        "type": "string",
                        "const": "minimal"
                      },
                      {
                        "type": "string",
                        "const": "low"
                      },
                      {
                        "type": "string",
                        "const": "medium"
                      },
                      {
                        "type": "string",
                        "const": "high"
                      },
                      {
                        "type": "string",
                        "const": "xhigh"
                      },
                      {
                        "type": "string",
                        "const": "max"
                      }
                    ]
                  }
                },
                "additionalProperties": false,
                "minProperties": 1
              },
              {
                "type": "object",
                "properties": {
                  "locale": {
                    "anyOf": [
                      {
                        "type": "string",
                        "const": "zh-CN"
                      },
                      {
                        "type": "string",
                        "const": "en"
                      }
                    ]
                  },
                  "account_view": {
                    "type": "object",
                    "properties": {
                      "source": {
                        "anyOf": [
                          {
                            "type": "object",
                            "required": [
                              "provider"
                            ],
                            "properties": {
                              "provider": {
                                "type": "object",
                                "required": [
                                  "pluginId",
                                  "providerId"
                                ],
                                "properties": {
                                  "pluginId": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 512,
                                    "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                                  },
                                  "providerId": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 512,
                                    "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                                  }
                                },
                                "additionalProperties": false
                              },
                              "connection": {
                                "type": "object",
                                "required": [
                                  "id",
                                  "revision"
                                ],
                                "properties": {
                                  "id": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 512,
                                    "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                                  },
                                  "revision": {
                                    "type": "string",
                                    "minLength": 1,
                                    "maxLength": 512,
                                    "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                                  }
                                },
                                "additionalProperties": false
                              },
                              "accountId": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 512,
                                "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                              }
                            },
                            "additionalProperties": false
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "sources": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "required": [
                            "provider"
                          ],
                          "properties": {
                            "provider": {
                              "type": "object",
                              "required": [
                                "pluginId",
                                "providerId"
                              ],
                              "properties": {
                                "pluginId": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 512,
                                  "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                                },
                                "providerId": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 512,
                                  "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                                }
                              },
                              "additionalProperties": false
                            },
                            "connection": {
                              "type": "object",
                              "required": [
                                "id",
                                "revision"
                              ],
                              "properties": {
                                "id": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 512,
                                  "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                                },
                                "revision": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 512,
                                  "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                                }
                              },
                              "additionalProperties": false
                            },
                            "accountId": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 512,
                              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                            }
                          },
                          "additionalProperties": false
                        },
                        "maxItems": 32
                      }
                    },
                    "additionalProperties": false,
                    "minProperties": 1
                  }
                },
                "additionalProperties": false,
                "minProperties": 1
              }
            ]
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": true
      },
      "execution": "immediate",
      "effects": [
        "application-configuration"
      ],
      "usage": {
        "purpose": "按用户要求修改回复语言、账户视图的精确连接/账户选择或已认证模型。偏好修改使用 configuration_read 返回的 preferences.version 作为 expected_version；不传凭据。模型切换不传 expected_version，queued 后等待本轮结束再确认。",
        "inputs": "target=preferences：changes 放最小偏好补丁，expected_version 来自 configuration_read.preferences.version；target=model：changes={provider,model,thinking?}，不传 expected_version。command_id 为该次修改的稳定 ID。",
        "outputs": "{id,target,status,changes,result?,error?}；preferences 的 applied 表示已持久化，model 可先 queued，当前回复结束后处理。",
        "prerequisites": [
          "主 Agent；模型必须在 configuration_read 中可用且已认证。"
        ],
        "limitations": [
          "version_conflict 时重读并以新 command_id 提交修订补丁；queued 时读取 recent_changes，不重复切换模型；unknown 时核对实际设置。"
        ]
      },
      "binding": {
        "type": "native",
        "name": "configuration_update"
      }
    },
    {
      "id": "configuration_open",
      "kind": "function",
      "consumers": [
        "agent",
        "host"
      ],
      "description": "按用户要求打开设置，或处理无法复用的模型认证。后端环境和连接由对应插件主动发现、导入并验证，不用此工具让用户手填。",
      "inputSchema": {
        "type": "object",
        "required": [
          "dialog"
        ],
        "properties": {
          "dialog": {
            "type": "string",
            "const": "settings"
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": true
      },
      "execution": "immediate",
      "effects": [
        "presentation"
      ],
      "usage": {
        "purpose": "按用户要求打开设置，或处理无法复用的模型认证。后端环境和连接由对应插件主动发现、导入并验证，不用此工具让用户手填。",
        "inputs": "dialog=\"settings\"；打开 Sesame 设置页，不接收凭据或平台连接参数。",
        "outputs": "宿主 views.open 的界面打开回执；不表示用户完成认证或配置。",
        "prerequisites": [
          "主 Agent 会话。"
        ],
        "limitations": [
          "平台连接由对应插件管理；需要状态确认时使用 configuration_read。"
        ]
      },
      "binding": {
        "type": "native",
        "name": "configuration_open"
      }
    }
  ],
  "sources": [],
  "views": [],
  "services": [],
  "knowledge": [
    {
      "id": "documentation-0",
      "path": "prompt.md",
      "description": "Documentation: prompt.md",
      "kind": "prompt"
    },
    {
      "id": "documentation-1",
      "path": "skills/configure-application/SKILL.md",
      "description": "Documentation: skills\\configure-application\\SKILL.md",
      "kind": "skill"
    }
  ],
  "hooks": [],
  "stateCollections": [],
  "artifactSchemas": []
}
