[
  {
    "name": "configuration_read",
    "label": "configuration_read",
    "description": "读取模型、认证状态、偏好和已安装插件。不会返回秘密或启动程序。连接设置由对应提供方插件管理。",
    "parameters": {
      "type": "object",
      "properties": {
        "section": {
          "anyOf": [
            {
              "type": "string",
              "const": "all"
            },
            {
              "type": "string",
              "const": "model"
            },
            {
              "type": "string",
              "const": "preferences"
            }
          ]
        },
        "provider": {
          "type": "string",
          "description": "供应商 ID",
          "minLength": 1,
          "maxLength": 20000
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "configuration_update",
    "label": "configuration_update",
    "description": "按用户要求修改回复语言、账户视图的精确连接/账户选择或已认证模型。偏好修改使用 configuration_read 返回的 preferences.version 作为 expected_version；不传凭据。模型切换不传 expected_version，queued 后等待本轮结束再确认。",
    "parameters": {
      "type": "object",
      "required": [
        "command_id",
        "target",
        "changes"
      ],
      "properties": {
        "command_id": {
          "type": "string",
          "minLength": 16,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "target": {
          "anyOf": [
            {
              "type": "string",
              "const": "model"
            },
            {
              "type": "string",
              "const": "preferences"
            }
          ]
        },
        "expected_version": {
          "type": "integer",
          "minimum": 1
        },
        "changes": {
          "anyOf": [
            {
              "type": "object",
              "required": [
                "provider",
                "model"
              ],
              "properties": {
                "provider": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "model": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "thinking": {
                  "anyOf": [
                    {
                      "type": "string",
                      "const": "off"
                    },
                    {
                      "type": "string",
                      "const": "minimal"
                    },
                    {
                      "type": "string",
                      "const": "low"
                    },
                    {
                      "type": "string",
                      "const": "medium"
                    },
                    {
                      "type": "string",
                      "const": "high"
                    },
                    {
                      "type": "string",
                      "const": "xhigh"
                    },
                    {
                      "type": "string",
                      "const": "max"
                    }
                  ]
                }
              },
              "additionalProperties": false,
              "minProperties": 1
            },
            {
              "type": "object",
              "properties": {
                "locale": {
                  "anyOf": [
                    {
                      "type": "string",
                      "const": "zh-CN"
                    },
                    {
                      "type": "string",
                      "const": "en"
                    }
                  ]
                },
                "account_view": {
                  "type": "object",
                  "properties": {
                    "source": {
                      "anyOf": [
                        {
                          "type": "object",
                          "required": [
                            "provider"
                          ],
                          "properties": {
                            "provider": {
                              "type": "object",
                              "required": [
                                "pluginId",
                                "providerId"
                              ],
                              "properties": {
                                "pluginId": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 512,
                                  "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                                },
                                "providerId": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 512,
                                  "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                                }
                              },
                              "additionalProperties": false
                            },
                            "connection": {
                              "type": "object",
                              "required": [
                                "id",
                                "revision"
                              ],
                              "properties": {
                                "id": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 512,
                                  "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                                },
                                "revision": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 512,
                                  "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                                }
                              },
                              "additionalProperties": false
                            },
                            "accountId": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 512,
                              "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                            }
                          },
                          "additionalProperties": false
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "sources": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "provider"
                        ],
                        "properties": {
                          "provider": {
                            "type": "object",
                            "required": [
                              "pluginId",
                              "providerId"
                            ],
                            "properties": {
                              "pluginId": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 512,
                                "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                              },
                              "providerId": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 512,
                                "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                              }
                            },
                            "additionalProperties": false
                          },
                          "connection": {
                            "type": "object",
                            "required": [
                              "id",
                              "revision"
                            ],
                            "properties": {
                              "id": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 512,
                                "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                              },
                              "revision": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 512,
                                "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                              }
                            },
                            "additionalProperties": false
                          },
                          "accountId": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 512,
                            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
                          }
                        },
                        "additionalProperties": false
                      },
                      "maxItems": 32
                    }
                  },
                  "additionalProperties": false,
                  "minProperties": 1
                }
              },
              "additionalProperties": false,
              "minProperties": 1
            }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "configuration_open",
    "label": "configuration_open",
    "description": "打开现有模型设置窗口，供用户安全填写凭据或完成授权。",
    "parameters": {
      "type": "object",
      "required": [
        "dialog"
      ],
      "properties": {
        "dialog": {
          "type": "string",
          "const": "settings"
        }
      },
      "additionalProperties": false
    }
  }
]
