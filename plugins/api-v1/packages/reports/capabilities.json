      "usage": {
        "purpose": "Publish Agent-authored HTML and packaged assets as an immutable report/1 artifact. All data and related artifacts are fixed references; report code gets only the read-only bridge. Publication does not claim successful rendering.",
        "inputs": "operation_id/title/summary/html_path/provenance_kind/data 必填；data=[{id,ref,...}] 将 HTML 的 bindingId 对应完整 DataRef。assets 打包本地资源；已有报告更新提供 artifact_id+expected_revision；strategy_source 将策略报告关联 SVL。",
        "outputs": "{ref,title,data,runtime,runtimeRevision,renderStatus:\"not_checked\"}；不可变报告已发布，尚无渲染成功证据。",
        "prerequisites": [
          "workspace 可读；所有引用已发布；HTML≤1MiB、打包总量≤16MiB；报告 API 与模板见公开 skills。"
        ],
        "limitations": [
          "同一 operation_id 对应同一固定内容；修改后用新 ID 和当前 revision。资源须打包，demo 输入必须保持 demo；渲染验收使用 report_check(ref)。"
        ]
      },
      "binding": {
        "type": "native",
        "name": "report_publish"
      }
