    "assets/charts-statistics.js",
    "assets/charts-temporal.js",
    "assets/charts-structure.js",
    "examples/chart-gallery.md",
    "examples/statistical-fixtures.json",
    "examples/temporal-fixtures.json",
    "examples/structural-fixtures.json",
