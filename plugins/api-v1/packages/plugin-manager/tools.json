[
  {
    "name": "plugin_discover",
    "label": "plugin_discover",
    "description": "列出允许发现的插件元数据。不会加载提示词、skill 正文或工具；不可使用的插件不出现。",
    "parameters": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "可选关键词",
          "minLength": 1,
          "maxLength": 20000
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "plugin_load",
    "label": "plugin_load",
    "description": "按需加载当前会话允许的可发现插件并立即刷新本轮工具与提示词。加载不改变全局默认状态。",
    "parameters": {
      "type": "object",
      "required": [
        "plugin_id"
      ],
      "properties": {
        "plugin_id": {
          "type": "string",
          "description": "插件 ID",
          "minLength": 1,
          "maxLength": 20000
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "plugin_catalog",
    "label": "plugin_catalog",
    "description": "查询独立的 Plugin API 1 development 官方可选目录，返回精确ID、版本、来源和catalog_digest。此目录不适用于稳定0.1.4；只读目录不会安装或下载依赖。",
    "parameters": {
      "type": "object",
      "properties": {
        "plugin_id": {
          "type": "string",
          "description": "精确 sesame/name，可不填",
          "minLength": 1,
          "maxLength": 20000
        },
        "query": {
          "type": "string",
          "description": "关键词，可不填",
          "minLength": 1,
          "maxLength": 20000
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "plugin_install_catalog",
    "label": "plugin_install_catalog",
    "description": "按已读取的catalog_digest安装精确官方可选插件：固定source commit，每文件和tree摘要校验，plugin_test→install实际activate→当前会话plugin_load。检查runtime_status；原生静态检查不等于行为测试，依赖准备另行显式执行。",
    "parameters": {
      "type": "object",
      "required": [
        "command_id",
        "plugin_id",
        "catalog_digest"
      ],
      "properties": {
        "command_id": {
          "type": "string",
          "minLength": 16,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$",
          "description": "稳定操作 ID；同一操作重试沿用此 ID"
        },
        "plugin_id": {
          "type": "string",
          "description": "目录精确 sesame/name",
          "minLength": 1,
          "maxLength": 20000
        },
        "catalog_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "plugin_read",
    "label": "plugin_read",
    "description": "读取已挂载插件中声明的提示词、skill 或参考资源。传入插件 ID 和目录清单中的相对 path。",
    "parameters": {
      "type": "object",
      "required": [
        "plugin_id",
        "path"
      ],
      "properties": {
        "plugin_id": {
          "type": "string",
          "description": "插件 ID",
          "minLength": 1,
          "maxLength": 20000
        },
        "path": {
          "type": "string",
          "description": "资源相对路径，例如 skills/analyze-data/SKILL.md",
          "minLength": 1,
          "maxLength": 20000
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "plugin_inspect",
    "label": "plugin_inspect",
    "description": "主 Agent 查看已安装外部插件的版本、摘要、诊断和可回滚版本；不会激活插件。",
    "parameters": {
      "type": "object",
      "required": [
        "plugin_id"
      ],
      "properties": {
        "plugin_id": {
          "type": "string",
          "description": "已安装的外部插件 ID",
          "minLength": 1,
          "maxLength": 20000
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "plugin_create",
    "label": "plugin_create",
    "description": "主 Agent 创建标准插件草稿。mcp-python 模板自带波动率工具和测试；随后用 write/edit 修改。",
    "parameters": {
      "type": "object",
      "required": [
        "command_id",
        "name",
        "description"
      ],
      "properties": {
        "command_id": {
          "type": "string",
          "minLength": 16,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$",
          "description": "稳定操作 ID；同一操作重试沿用此 ID"
        },
        "name": {
          "type": "string",
          "description": "小写插件名称",
          "minLength": 1,
          "maxLength": 20000
        },
        "description": {
          "type": "string",
          "description": "用途与触发条件",
          "minLength": 1,
          "maxLength": 20000
        },
        "version": {
          "type": "string",
          "description": "SemVer，默认 0.1.0",
          "minLength": 1,
          "maxLength": 20000
        },
        "template": {
          "anyOf": [
            {
              "type": "string",
              "const": "skill"
            },
            {
              "type": "string",
              "const": "mcp-python"
            }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "plugin_validate",
    "label": "plugin_validate",
    "description": "静态验证 sesame-native/apiVersion1、标准MCP、Claude/Codex与独立skill草稿；不执行代码。返回兼容诊断和内容摘要。",
    "parameters": {
      "type": "object",
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "description": "插件草稿的实际工作区路径，或相对当前真实工作区 root 的目录",
          "minLength": 1,
          "maxLength": 20000
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "plugin_test",
    "label": "plugin_test",
    "description": "原生API1包仅检查清单、schema和JS语法，不执行工厂或实际工具，不证明行为安全。stdio MCP在本机当前用户权限下检查工具并执行包内断言；远程MCP仅读已授权schema。记录精确摘要与依赖锁。",
    "parameters": {
      "type": "object",
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "description": "插件草稿的实际工作区路径，或相对当前真实工作区 root 的目录",
          "minLength": 1,
          "maxLength": 20000
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "plugin_install",
    "label": "plugin_install",
    "description": "安装通过对应检查的精确摘要，默认可发现；原生包实际执行activate。读取runtime_status与diagnostics，成功后plugin_load立即加载本轮工具。依赖下载与环境准备不会由此操作自动授权。",
    "parameters": {
      "type": "object",
      "required": [
        "path",
        "command_id",
        "digest"
      ],
      "properties": {
        "path": {
          "type": "string",
          "description": "插件草稿的实际工作区路径，或相对当前真实工作区 root 的目录",
          "minLength": 1,
          "maxLength": 20000
        },
        "command_id": {
          "type": "string",
          "minLength": 16,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$",
          "description": "稳定操作 ID；同一操作重试沿用此 ID"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "plugin_set_state",
    "label": "plugin_set_state",
    "description": "仅改变已安装外部插件的 mounted/discoverable/disabled 策略；不修改内置插件、网络授权或交易权限。",
    "parameters": {
      "type": "object",
      "required": [
        "plugin_id",
        "command_id",
        "state",
        "expected_version"
      ],
      "properties": {
        "plugin_id": {
          "type": "string",
          "description": "已安装的外部插件 ID",
          "minLength": 1,
          "maxLength": 20000
        },
        "command_id": {
          "type": "string",
          "minLength": 16,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$",
          "description": "稳定操作 ID；同一操作重试沿用此 ID"
        },
        "state": {
          "anyOf": [
            {
              "type": "string",
              "const": "mounted"
            },
            {
              "type": "string",
              "const": "discoverable"
            },
            {
              "type": "string",
              "const": "disabled"
            }
          ]
        },
        "expected_version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "plugin_update",
    "label": "plugin_update",
    "description": "从已测试草稿升级外部插件；要求更高版本和匹配的当前摘要。保留旧包及持久数据。",
    "parameters": {
      "type": "object",
      "required": [
        "path",
        "command_id",
        "digest",
        "expected_digest"
      ],
      "properties": {
        "path": {
          "type": "string",
          "description": "插件草稿的实际工作区路径，或相对当前真实工作区 root 的目录",
          "minLength": 1,
          "maxLength": 20000
        },
        "command_id": {
          "type": "string",
          "minLength": 16,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$",
          "description": "稳定操作 ID；同一操作重试沿用此 ID"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "expected_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "plugin_rollback",
    "label": "plugin_rollback",
    "description": "切换到已安装且已测试的历史摘要；保留 PLUGIN_DATA，不自动回滚业务数据。",
    "parameters": {
      "type": "object",
      "required": [
        "plugin_id",
        "command_id",
        "expected_digest",
        "digest"
      ],
      "properties": {
        "plugin_id": {
          "type": "string",
          "description": "已安装的外部插件 ID",
          "minLength": 1,
          "maxLength": 20000
        },
        "command_id": {
          "type": "string",
          "minLength": 16,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$",
          "description": "稳定操作 ID；同一操作重试沿用此 ID"
        },
        "expected_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "plugin_uninstall",
    "label": "plugin_uninstall",
    "description": "卸载外部插件并撤销工具注册；保留版本审计与持久数据。依赖方存在时拒绝。",
    "parameters": {
      "type": "object",
      "required": [
        "plugin_id",
        "command_id",
        "expected_digest"
      ],
      "properties": {
        "plugin_id": {
          "type": "string",
          "description": "已安装的外部插件 ID",
          "minLength": 1,
          "maxLength": 20000
        },
        "command_id": {
          "type": "string",
          "minLength": 16,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$",
          "description": "稳定操作 ID；同一操作重试沿用此 ID"
        },
        "expected_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "plugin_export",
    "label": "plugin_export",
    "description": "将可兼容插件导出到当前工作区plugin-exports并返回实际路径；原生API1包不可无损转换成Claude/Codex，必须保留原生格式。不会安装到其他客户端。",
    "parameters": {
      "type": "object",
      "required": [
        "plugin_id",
        "command_id",
        "target"
      ],
      "properties": {
        "plugin_id": {
          "type": "string",
          "description": "已安装的外部插件 ID",
          "minLength": 1,
          "maxLength": 20000
        },
        "command_id": {
          "type": "string",
          "minLength": 16,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$",
          "description": "稳定操作 ID；同一操作重试沿用此 ID"
        },
        "target": {
          "anyOf": [
            {
              "type": "string",
              "const": "agent-plugins"
            },
            {
              "type": "string",
              "const": "claude"
            },
            {
              "type": "string",
              "const": "codex"
            }
          ]
        }
      },
      "additionalProperties": false
    }
  }
]
