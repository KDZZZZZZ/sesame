{
  "id": "sesame/data-access",
  "title": "数据与研究证据",
  "description": "发现提供方、查询与冻结数据、读取输入和登记可追溯代码计算结果。",
  "version": "3.0.2",
  "default_state": "mounted",
  "prompts": [
    "prompt.md"
  ],
  "skills": [
    "skills"
  ],
  "entry": "index.js",
  "apiVersion": "2",
  "license": "MIT",
  "engines": {
    "sesame": ">=0.3.0-dev.1 <0.4.0"
  },
  "execution": "native",
  "capability_manifest": "capabilities.json",
  "mcp_export": [
    "data_read"
  ],
  "dependencies": [
    {
      "name": "sesame/workspace",
      "version": ">=3.0.0"
    }
  ],
  "permissions": {
    "scopes": [
      "capabilities.compose"
    ],
    "calls": [
      "host.datasets.query",
      "host.executions.query"
    ]
  }
}
